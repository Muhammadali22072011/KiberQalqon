# ============================================================
#  SECRETS — NEVER commit (signing keys, tokens, SDK paths)
# ============================================================
local.properties
keystore.properties
*.keystore
*.jks
release.keystore*
**/.env
**/.env.local
**/.env.*.local

# ============================================================
#  MALWARE SAMPLES & APKs — keep OFF GitHub
#  (live malware violates GitHub ToS and can get the account
#   banned; built APKs are regenerable)
# ============================================================
*.apk
*.dex
*.smali
*.bin
*.zip
*.7z
*.7z.*
/samples/
/вирусы/
/новые вирусы/
/VIRUS_ANALYSIS/
/VIRUS_DECOMPILED/
/apk_decoded/
/apk_extracted/
/apk_unpacked/
/design_extracted/
/sources/
/resources/
/competitor_cyberhimoya/
**/unpacked/
# Karantin-papkalar: malware namunalari va dekompilyatsiya qilingan begona ilova kodlari.
# Butun katalog bilan e'tiborga olinmaydi (faqat kengaytma bo'yicha emas) — bitta `git add -A`
# raqobatchining dekompilyatsiya qilingan kodi (mualliflik huquqi + RE izi) yoki .xapk/переименованный
# sample'ni jim qo'shib qo'ymasin.
/_samples/
/_competitor/

# ============================================================
#  BUNDLED TOOLING — large & regenerable
# ============================================================
/jdk/
/jadx_tool/
apktool_*.jar

# ============================================================
#  BUILD OUTPUTS
# ============================================================
build/
**/build/
.gradle/
.cxx/
captures/
node_modules/
.vercel/
__pycache__/
*.pyc
*.class

# ============================================================
#  IDE / OS
# ============================================================
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# ============================================================
#  LOGS & LARGE GENERATED REPORTS
# ============================================================
*.log
build_log.txt
scan_report_*.txt
result_analiza.txt

# ============================================================
#  ROOT SCREENSHOTS (ишчи скриншотлар — репога керак эмас)
# ============================================================
/kq_screen*.png
/s3.png
/s4.png
/s5.png

# ============================================================
#  ISHCHI/VAQTINCHALIK FAYLLAR — repoга kerak emas
#  (manba variable-shriftlar; statik instanslar app/res/font ичида,
#   pitch'ga ulanmagan yuklab olingan video)
# ============================================================
/fonts_tmp/
/pitch/SaveVid_Net_*.mp4
