# ============================================================
#  SECRETS — NEVER commit (signing keys, tokens, SDK paths)
# ============================================================
local.properties
keystore.properties
*.keystore
*.jks
release.keystore*
**/.env
**/.env.local
**/.env.*.local

# ============================================================
#  MALWARE SAMPLES & APKs — keep OFF GitHub
#  (live malware violates GitHub ToS and can get the account
#   banned; built APKs are regenerable)
#
#  Butun /malware/ karantin katalogi: namunalar, dekompilyatsiya
#  qilingan begona ilova kodlari va raqobatchi ilova kodi.
#  Kengaytma bo'yicha emas, butun katalog bilan e'tiborga olinmaydi —
#  bitta `git add -A` hech narsani jim qo'shib qo'ymasin.
# ============================================================
*.apk
*.dex
*.smali
*.bin
*.zip
*.7z
*.7z.*
/malware/
/builds/
**/unpacked/

# ============================================================
#  BUNDLED TOOLING — large & regenerable
# ============================================================
/tools/jdk/
/tools/jadx_tool/
/tools/apktool_*.jar

# ============================================================
#  BUILD OUTPUTS
# ============================================================
build/
**/build/
.gradle/
.cxx/
captures/
node_modules/
.vercel/
__pycache__/
*.pyc
*.class

# ============================================================
#  IDE / OS
# ============================================================
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# ============================================================
#  LOGS & LARGE GENERATED REPORTS
#  (reports/unpacked_files_*.txt — qo'lda saqlanadi, git'da qoladi)
# ============================================================
*.log
/reports/scan_report_*.txt
/reports/result_analiza.txt

# ============================================================
#  ROOT SCREENSHOTS (ishchi skrinshotlar — repoga kerak emas)
# ============================================================
/kq_screen*.png
/s3.png
/s4.png
/s5.png
