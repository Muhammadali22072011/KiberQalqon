# Supabase — Dashboard → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...

# Telegram — @BotFather'dan olinadi
TELEGRAM_BOT_TOKEN=1234567890:AAH...
# Webhook'ga keluvchi so'rovlarni tasdiqlash (random string, o'zing tanlaysan)
TELEGRAM_WEBHOOK_SECRET=change-me-to-random-32-chars

# Android ilovasi /api/scan/upload'ga shu kalit bilan keladi (APK ichida Shield shifrida).
# O'TISH DAVRI kaliti: yangi APK per-device imzo (pastdagi DEVICE_TOKEN_SECRET) ishlatadi,
# lekin daladagi ESKI APK'lar hali shu umumiy kalit bilan kelaveradi — DARROV O'CHIRMANG.
DEVICE_SHARED_SECRET=change-me-to-another-random-32-chars

# Per-device YOZUV imzosi kaliti (YANGI, anti-RE). Register'da qurilma HMAC(device_token)
# token oladi va keyingi yozuvlarni shu bilan imzolaydi (+ timestamp + nonce replay-himoya).
# Shu sabab APK'dan o'g'irlangan umumiy sirning foydasi kam. Bo'sh bo'lsa SESSION_SECRET/
# ADMIN_SECRET ishlatiladi — alohida random qo'ygan MA'QUL. APK ICHIGA QO'YILMAYDI (server-only).
DEVICE_TOKEN_SECRET=change-me-to-a-random-32-chars

# Imzolangan remote-config (verdikt chegaralari) HMAC kaliti. APK ichida ham (Shield
# shifrida, local.properties → config.signing.secret) bor — IKKALASI BIR XIL bo'lsin.
# Bo'sh bo'lsa /api/config "unconfigured" qaytaradi va ilova baked standartlarda qoladi.
CONFIG_SIGNING_SECRET=change-me-to-a-random-32-chars

# Panel (o'qish: /api/stats, /api/devices, /api/threats, /api/geo, /api/device/:id)
# uchun alohida kalit — APK ICHIGA QO'YILMAYDI. Faqat panelda ishlatiladi.
ADMIN_SECRET=change-me-to-a-different-random-32-chars

# Birinchi admin chat_id (botga /start yozib, log'dan olinadi yoki @userinfobot)
ADMIN_CHAT_IDS=123456789

# ── Panelga QIYIN kirish (2FA) — IXTIYORIY, lekin tavsiya etiladi ──────────────
# Panel kirishini kuchaytiradi: ADMIN_SECRET (parol) + autentifikator ilovasidagi
# 6 xonali kod. Bo'sh qoldirsangiz — faqat parol (lockout bo'lmasin). To'ldirsangiz
# 2FA majburiy bo'ladi.
#   1) base32 sekret yarating:  node -e "console.log(require('./lib/totp.js').generateBase32Secret?.()||'')"
#      (yoki istalgan TOTP generatordan base32 sekret oling)
#   2) shu sekretni Google Authenticator / Authy'ga "qo'lda kalit" sifatida kiriting
#   3) shu yerga ham yozing:
ADMIN_TOTP_SECRET=

# Sessiya tokenini imzolash kaliti (panelga kirgach beriladigan qisqa muddatli token).
# Bo'sh bo'lsa ADMIN_SECRET ishlatiladi. CRIT-01 audit: ALOHIDA random qo'ying va
# DEVICE_TOKEN_SECRET bilan BIR XIL QILMANG (domen-prefikslar himoya qiladi, lekin
# kalitlarni ajratish — qo'shimcha qatlam).
SESSION_SECRET=change-me-to-yet-another-random-32-chars

# ── Bitta cheklangan ADMIN hisobi (login + parol) ─────────────────────────────
# Egasi (master kalit) — to'liq huquq. Admin esa faqat KO'RADI, EKSPORT qiladi va
# E'LON joylaydi (o'zgartira/o'chira olmaydi). Panelda "Admin" tabidan kiradi.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── RO'YXATDAN O'TISH BOTI (ochiq bot — ilovadagi tugma shuni ochadi) ─────────
# Egasi paneli botidan ALOHIDA bot. Ochiq bot minglab notanish chatdan xabar
# oladi; panel boti hech qachon olmasligi kerak — shuning uchun token ham,
# webhook siri ham ajratilgan. Ikkalasi bitta funksiyada (Hobby 12-limit),
# ajratuvchi — webhook URL'idagi ?bot=reg.
TELEGRAM_REG_BOT_TOKEN=
# @username, '@' SIZ. Chuqur havola shundan quriladi: https://t.me/<username>?start=<token>
TELEGRAM_REG_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET dan BOSHQA random 32 hex.
TELEGRAM_REG_WEBHOOK_SECRET=
# Bot xabaridagi «UzGuard'ga qaytish» tugmasi shu manzildagi /back.html ni ochadi.
# Bo'sh bo'lsa tugma ko'rsatilmaydi (ilova baribir pollingda holatni ko'radi).
PUBLIC_BASE_URL=https://uzguard-cloud.vercel.app
