# Supabase — Dashboard → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...

# Telegram — @BotFather'dan olinadi
TELEGRAM_BOT_TOKEN=1234567890:AAH...
# Webhook'ga keluvchi so'rovlarni tasdiqlash (random string, o'zing tanlaysan)
TELEGRAM_WEBHOOK_SECRET=change-me-to-random-32-chars

# Android ilovasi /api/scan/upload'ga shu kalit bilan keladi (APK ichida saqlanadi)
DEVICE_SHARED_SECRET=change-me-to-another-random-32-chars

# Panel (o'qish: /api/stats, /api/devices, /api/threats, /api/geo, /api/device/:id)
# uchun alohida kalit — APK ICHIGA QO'YILMAYDI. Faqat panelda ishlatiladi.
ADMIN_SECRET=change-me-to-a-different-random-32-chars

# Birinchi admin chat_id (botga /start yozib, log'dan olinadi yoki @userinfobot)
ADMIN_CHAT_IDS=123456789

# ── Panelga QIYIN kirish (2FA) — IXTIYORIY, lekin tavsiya etiladi ──────────────
# Panel kirishini kuchaytiradi: ADMIN_SECRET (parol) + autentifikator ilovasidagi
# 6 xonali kod. Bo'sh qoldirsangiz — faqat parol (lockout bo'lmasin). To'ldirsangiz
# 2FA majburiy bo'ladi.
#   1) base32 sekret yarating:  node -e "console.log(require('./lib/totp.js').generateBase32Secret?.()||'')"
#      (yoki istalgan TOTP generatordan base32 sekret oling)
#   2) shu sekretni Google Authenticator / Authy'ga "qo'lda kalit" sifatida kiriting
#   3) shu yerga ham yozing:
ADMIN_TOTP_SECRET=

# Sessiya tokenini imzolash kaliti (panelga kirgach beriladigan qisqa muddatli token).
# Bo'sh bo'lsa ADMIN_SECRET ishlatiladi — alohida random qo'ysangiz yaxshiroq.
SESSION_SECRET=

# ── Bitta cheklangan ADMIN hisobi (login + parol) ─────────────────────────────
# Egasi (master kalit) — to'liq huquq. Admin esa faqat KO'RADI, EKSPORT qiladi va
# E'LON joylaydi (o'zgartira/o'chira olmaydi). Panelda "Admin" tabidan kiradi.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
