<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         РАЗРЕШЕНИЯ ДЛЯ ВСЕХ ANDROID (7 → 15)
         ============================================================ -->

    <!-- Android 7-9 (API 24-28): обычное чтение/запись хранилища. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- WRITE_EXTERNAL_STORAGE расширили до API 29 — на Android 10 с requestLegacyExternalStorage=true оно ещё работает. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Android 11+ (API 30+): единственный способ удалять любой APK без бесконечных диалогов.
         Запрашивается явно в SplashActivity → откроется системный экран "Доступ ко всем файлам". -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Android 13+ (API 33+): гранулированные media-разрешения. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Установка APK: на 8+ нужно явное REQUEST_INSTALL_PACKAGES + юзер включает
         "Неизвестные источники" для нашего пакета. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- QR-skaner (havola tekshiruvi): kamera FAQAT QrScanActivity ochilganda so'raladi.
         required=false — kamerasiz qurilmalarda ham ilova o'rnatiladi (QR funksiyasi yashiriladi). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Geo-monitoring: qurilma o'z aniq joylashuvini markaziy xaritaga yuboradi.
         FAQAT "Jamoatchilik xavfsizligi" opt-in yoqilgan bo'lsa so'raladi va yuboriladi
         (CloudTelemetry darvozasi). Rad etilsa — server IP'dan shahar darajasida taxminlaydi.
         Fon (background) joylashuv SO'RALMAYDI: koordinata faqat ilova ishlatilayotganda
         (skan / ishga tushish) o'qiladi. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ (API 34): antivirus ilovasi uchun "specialUse" foreground type
         talab qilinadi. ProtectionService doimiy himoya bildirishnomasi uchun. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Полноэкранные warning'и поверх блокировки экрана. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Xiaomi/MIUI, Huawei, Samsung agressiv battery optimization WorkManager'ni
         o'ldiradi. Bu ruxsat foydalanuvchidan "Doze list'ga qo'shma" deyish
         imkonini beradi — periodik 15-daq skan ishonchli ishlashi uchun muhim. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ENG-01: antivirus uchun BARCHA paketlarni ko'rish SHART. Android 11+ da <queries>
         MAIN/LAUNCHER faqat launcher-ikonkasi BOR ilovalarni ko'rsatadi — ikonkasini yashirgan
         malware (Ajina-simon dropperlarning asosiy persistensiya hiylasi) "Yashirin tahdidlar"
         skaneri, kunlik re-scan va Telegram ro'yxatига UMUMAN ko'rinmasdi (yolg'on "toza").
         QUERY_ALL_PACKAGES — AV ilovalari uchun Play'da ruxsat etilgan kategoriya; sideload'da
         cheklov yo'q. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- getLaunchIntentForPackage() / launcher tekshiruvi uchun (QUERY_ALL_PACKAGES bo'lmasa ham). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KiberQalqon"
        android:requestLegacyExternalStorage="true"
        android:preserveLegacyExternalStorage="true"
        tools:targetApi="31">
        
        <!-- Til tanlash — eng birinchi ekran (LAUNCHER). Til tanlangach Splash'ga o'tadi;
             keyingi ochilishlarda ko'rinmasdan darhol Splash'ga yo'naltiradi. -->
        <activity
            android:name=".LanguageSelectActivity"
            android:exported="true"
            android:theme="@style/Theme.KiberQalqon"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Splash Screen - запускается из LanguageSelectActivity (или из notification).
             exported=false: tashqi intent bilan ochilmaydi (LAUNCHER — LanguageSelect; ichki
             PendingIntent'lar exported talab qilmaydi). Keraksiz attack surface'ni yopadi. -->
        <activity
            android:name=".SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon"
            android:screenOrientation="portrait" />
        
        <!-- Главный экран -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon" />

        <!-- Mandatory consent screen — ToS + Privacy Policy. Pokazyvayetsya pered
             pervym zapuskom MainActivity. Bez yavnogo soglasiya app ne idet dal'she. -->
        <activity
            android:name=".ConsentActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon"
            android:label="Foydalanish shartlari"
            android:screenOrientation="portrait"
            android:excludeFromRecents="false" />

        <activity
            android:name=".ScanHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon" />

        <!-- Диагностика: открывается из SplashActivity (long-press на версии).
             Никаких особых тем — нативный белый фон, чтобы экран показался ВСЕГДА,
             даже если KiberQalqon тема упала. -->
        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false" />

        <!-- Yashirin / o'chmaydigan tahdidlar skaneri (HiddenThreatScanner + qadamma-qadam o'chirish). -->
        <activity
            android:name=".HiddenThreatsActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon" />

        <activity
            android:name=".TelemetrySettingsActivity"
            android:exported="false"
            android:label="Telegram telemetriya" />
            
        <activity
            android:name=".ScanResultActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon" />

        <!-- v4: skan natijasidan ochiladigan «So'ralgan ruxsatlar» batafsil ekrani. -->
        <activity
            android:name=".PermissionsDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon" />

        <!-- UX-01: Karantin ekrani — tiklash/butunlay o'chirish (Dashboard "Karantin" plitkasidan). -->
        <activity
            android:name=".QuarantineActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon" />

        <activity
            android:name=".ReportProblemActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon" />

        <!-- Boshqaruv paneli (admin) — veb-panelni ilova ichida WebView orqali ochadi.
             exported=false: tashqi intent bilan ochib bo'lmaydi. -->
        <activity
            android:name=".AdminPanelActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon"
            android:screenOrientation="portrait" />

        <!-- Himoya holati — kirishda barcha ruxsat/sozlamalarni ko'rsatadi. -->
        <activity
            android:name=".ProtectionStatusActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon"
            android:screenOrientation="portrait" />

        <!-- Окно предупреждения - поверх всех окон.
             exported=false: запускается только нашим WorkManager/FileObserver, никаких внешних intent.
             Защищает от intent-injection — иначе любое приложение могло бы вызвать fake-предупреждение
             с произвольным apk_path. -->
        <activity
            android:name=".AutoScanActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity="" />
        
        <activity
            android:name=".DashboardNewActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon" />

        <!-- Havola tekshiruvchi — Telegram/SMS'dan kelgan URL'ni offline tahlil qiladi. -->
        <activity
            android:name=".LinkCheckActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon"
            android:screenOrientation="portrait" />

        <!-- Yangiliklar — bulut e'lonlari to'liq ro'yxati (dashboard karuseli → Hammasi). -->
        <activity
            android:name=".NewsActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon"
            android:screenOrientation="portrait" />

        <!-- HAVOLA QALQONI (link interceptor): foydalanuvchi KiberQalqon'ni standart havola
             ochuvchi qilib tanlasa, har bir tashqi http(s) havola AVVAL shu ko'rinmas Activity'ga
             keladi — LinkScanner tekshiradi, xavfsiz bo'lsa brauzerga uzatadi, xavfli bo'lsa
             LinkBlockActivity'ni ko'rsatadi. exported=true (tashqi VIEW intent ushlanadi), lekin
             u faqat URL'ni tahlil qiladi — apk_path injeksiyasiga o'rin yo'q. Translucent + sof
             Activity (AppCompat EMAS) — ShareUrlReceiverActivity bilan bir xil sabab. -->
        <activity
            android:name=".LinkGuardActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Havola blok ekrani — SHUBHALI/XAVFLI havolada saytni ochmasdan logo+ogohlantirish
             ko'rsatadi. exported=false: faqat LinkGuardActivity ichki intent bilan ochadi. -->
        <activity
            android:name=".LinkBlockActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait" />

        <!-- O'z-o'zini yangilash tasdiq oynasi (bildirishnomadan ochiladi). Ko'rinmas
             (translucent) + sof Activity. exported=false: faqat ichki PendingIntent. -->
        <activity
            android:name=".SelfUpdateActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- QR-skaner — kamera orqali QR o'qiydi va ichidagi havolani tekshiruvga uzatadi. -->
        <activity
            android:name=".QrScanActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon"
            android:screenOrientation="portrait" />

        <!-- Soxta bank ilovalari auditi — bank brendiga taqlid qiluvchi ilovalarni topadi. -->
        <activity
            android:name=".BankGuardActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon"
            android:screenOrientation="portrait" />

        <!-- Ruxsatlar rentgeni — o'rnatilgan ilovalarni xavfli ruxsat kombinatsiyalari bo'yicha baholaydi. -->
        <activity
            android:name=".PermissionXrayActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon"
            android:screenOrientation="portrait" />

        <!-- Birinchi to'liq tekshiruv — odin raz srazu posle Onboarding,
             pokazyvayet vse opasnye APK na ustroystve s knopkami "O'chirish". -->
        <activity
            android:name=".InitialScanActivity"
            android:exported="false"
            android:theme="@style/Theme.KiberQalqon"
            android:screenOrientation="portrait" />

        <!-- Приёмник Share/Open: "Поделиться → KiberQalqon" из Telegram, файл-менеджера,
             браузера и т.п. + перехват "Open with..." для любого APK перед установкой.
             Сама эта Activity невидимая — копирует APK в cacheDir и запускает AutoScanActivity. -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">

            <!-- "Поделиться → KiberQalqon" из любого приложения. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>

            <!-- "Открыть с помощью..." когда юзер тапает APK в файл-менеджере, Telegram, браузере.
                 Так KiberQalqon станет одной из опций — юзер выберет нас вместо PackageInstaller,
                 мы просканируем и только потом разрешим установку. -->
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/vnd.android.package-archive" />
                <data android:scheme="file" android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>

            <!-- Тот же VIEW но с *.apk суффиксом — для старых файл-менеджеров,
                 которые отдают MIME как */* и полагаются на расширение. -->
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <!-- UX (past): Android PatternMatcher'da `.*` ochko'z emas — `.*\.apk` nomda
                     QO'SHIMCHA nuqta bo'lsa (app-1.2.3.apk, kiberqalqon-1749...apk) MOS KELMAYDI.
                     Shu sabab nuqta darajalari bo'yicha bir necha pattern beramiz. -->
                <data android:pathPattern=".*\\.apk" />
                <data android:pathPattern=".*\\..*\\.apk" />
                <data android:pathPattern=".*\\..*\\..*\\.apk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.apk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.apk" />
                <data android:host="*" />
            </intent-filter>
        </activity>

        <!-- "Ulashish → KiberQalqon" matn (text/plain) uchun: Telegram/SMS/brauzerdan havolani
             ulashganda URL'ni ushlaб, LinkCheckActivity'ga uzatadi. Ko'rinmas (translucent) —
             EXTRA_TEXT'dan birinchi URL'ni olib darhol yopiladi. -->
        <activity
            android:name=".ShareUrlReceiverActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Quick Settings Tile: "Сканировать сейчас" в шторке Android. -->
        <service
            android:name=".ScanTileService"
            android:exported="true"
            android:icon="@drawable/ic_shield"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- FileProvider для передачи APK в системный PackageInstaller.
             Нельзя отдавать file:// URI на Android 7+ — система кинет FileUriExposedException. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- Doimiy himoya foreground service'i — App.onCreate'da ishga tushadi
             va to'xtatilmaguncha status bar'da "KIBER QALQON faol" yozuvini
             ko'rsatib turadi. Android 14+ uchun specialUse property kerak. -->
        <service
            android:name=".ProtectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Real-time APK and installed app malware protection — antivirus security monitoring" />
        </service>

        <!-- TAJRIBAVIY (opt-in, default OFF): DNS-sinkhole VPN — ma'lum C2 domenlarini bloklaydi.
             Settings'dagi toggle orqali yoqiladi (VpnService.prepare oqimi SettingsActivity'da).
             Domenlar: baked IOC to'plami + bulut feed'i (ThreatDb, api/threats?feed=1).
             Fail-open: upstream DNS ketma-ket ishlamasa VPN o'zini O'CHIRADI — filtr buzilsa
             ham internet hech qachon bloklanib qolmaydi. -->
        <service
            android:name=".VpnFilterService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name=".PhishingNotificationService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Bosh ekran widget'i — KiberQalqon himoyasi holatini ko'rsatadi.
             updatePeriodMillis=0 (xml/kq_widget_info.xml): periodic update yo'q,
             biz scan tugagach KqWidgetProvider.refreshAll() chaqiramiz. -->
        <receiver
            android:name=".KqWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kq_widget_info" />
        </receiver>

        <!-- BootReceiver: prikhodit posle perezagruzki telefona.
             Eto edinstvennyj sposob uznat' o boot — manifest-only event.
             Otpravlyaem BOOT_COMPLETED v Telegram + razbuzhivaem WorkManager. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <!-- BG-01: ilova yangilangach real-time himoyani qaytaramiz (fon-FGS cheklovidan istisno). -->
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
