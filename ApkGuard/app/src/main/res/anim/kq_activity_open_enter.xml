<?xml version="1.0" encoding="utf-8"?>
<!-- Yangi ekran kirishi: o'ngdan yengil suriladi + paydo bo'ladi + sal kattalashadi.
     "Yengil" his uchun translate atigi 12% (to'liq ekran sirg'alishi og'ir ko'rinadi). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint">
    <translate
        android:fromXDelta="12%p"
        android:toXDelta="0"
        android:duration="280" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="220" />
    <scale
        android:fromXScale="0.97"
        android:toXScale="1.0"
        android:fromYScale="0.97"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="280" />
</set>
