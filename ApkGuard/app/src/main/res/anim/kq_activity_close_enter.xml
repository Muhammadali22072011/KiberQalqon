<?xml version="1.0" encoding="utf-8"?>
<!-- Orqaga qaytishda oldingi ekran qaytishi: chapdan yengil suriladi + to'liq paydo bo'ladi. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint">
    <translate
        android:fromXDelta="-8%p"
        android:toXDelta="0"
        android:duration="280" />
    <alpha
        android:fromAlpha="0.6"
        android:toAlpha="1.0"
        android:duration="280" />
    <scale
        android:fromXScale="0.98"
        android:toXScale="1.0"
        android:fromYScale="0.98"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="280" />
</set>
