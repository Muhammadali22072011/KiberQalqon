    <string name="kq4_onb_step" translatable="false">%1$d · %2$d</string>
    <string name="kq4_onb_title_1">Telefoningizni o\'zi tekshiradi</string>
    <string name="kq4_onb_body_1">Anor Qalqon Telegram, WhatsApp va yuklab olingan fayllarni o\'zi kuzatib turadi. Siz hech narsa qilishingiz shart emas.</string>
    <string name="kq4_onb_title_2">Xavfli dasturlarni topadi</string>
    <string name="kq4_onb_body_2">Rasm yoki video deb yashiringan zararli fayllar aniqlanadi. Ular bank parolingiz va SMS kodlaringizni o\'g\'irlashga urinadi.</string>
    <string name="kq4_onb_title_3">Sodda til, kuchli himoya</string>
    <string name="kq4_onb_body_3">Hamma narsa o\'zbek tilida, oddiy so\'zlar bilan tushuntiriladi. Murakkab texnik atamalar yo\'q — faqat siz uchun muhim narsa.</string>
    <!-- oxirgi slayd tugmasi -->
    <string name="kq4_onb_enable">Himoyani yoqish</string>

