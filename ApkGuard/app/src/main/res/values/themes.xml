<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base theme. Activities apply one of the three Accent overlays below at
      runtime via ThemeHelper.applyAccent(...) so `kq_primary` (a state list
      pointing at `?attr/kqPrimary`) resolves to whichever colour the user
      picked in Settings.

      Default = Anor (matches the design screenshots Le Muhammadali shipped on
      2026-05-22). ThemeHelper reads the stored pref and picks Anor/Feruz/Zafaron.
    -->
    <style name="Theme.KiberQalqon" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/kq_feruz</item>
        <item name="colorPrimaryDark">@color/kq_feruz_2</item>
        <item name="colorAccent">@color/kq_feruz</item>
        <item name="colorControlNormal">@color/kq_ink_3</item>
        <item name="colorControlActivated">@color/kq_feruz</item>
        <item name="colorControlHighlight">@color/kq_feruz_soft</item>

        <!-- Yorug' minimal: oqish-krem fon, quyuq-ko'k matn, yorug' status/nav panel. -->
        <item name="android:statusBarColor">@color/kq_bg</item>
        <item name="android:navigationBarColor">@color/kq_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/kq_bg</item>
        <item name="android:colorBackground">@color/kq_bg</item>

        <item name="android:textColorPrimary">@color/kq_ink</item>
        <item name="android:textColorSecondary">@color/kq_ink_2</item>
        <item name="android:textColorHint">@color/kq_ink_3</item>

        <!-- Butun ilova bo'ylab yengil, animatsiyali ekran o'tishlari (bitta joydan
             barcha Activity'larga qo'llanadi; Anor/Feruz/Zafaron ham meros oladi). -->
        <item name="android:windowAnimationStyle">@style/KqWindowAnimations</item>

        <!-- Default accent = Feruz (turkuaz). .Anor / .Zafaron child themes override these. -->
        <item name="kqPrimary">@color/kq_feruz</item>
        <item name="kqPrimary2">@color/kq_feruz_2</item>
        <item name="kqPrimarySoft">@color/kq_feruz_soft</item>
    </style>

    <!-- Ekrandan ekranga o'tish animatsiyalari. Oldinga: yangi ekran o'ngdan yengil
         suriladi + paydo bo'ladi; eski ekran chapga parallaks bilan chekinadi.
         Orqaga: aksincha. task* — ilova tashqaridan ochil/yopilganda. -->
    <style name="KqWindowAnimations">
        <item name="android:activityOpenEnterAnimation">@anim/kq_activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/kq_activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/kq_activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/kq_activity_close_exit</item>
        <item name="android:taskOpenEnterAnimation">@anim/kq_activity_open_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/kq_activity_open_exit</item>
        <item name="android:taskCloseEnterAnimation">@anim/kq_activity_close_enter</item>
        <item name="android:taskCloseExitAnimation">@anim/kq_activity_close_exit</item>
    </style>

    <!-- Accent overlays — applied via Activity.setTheme() in attachBaseContext.
         colorPrimary/colorAccent set too so MaterialSwitch / MaterialButton /
         MaterialCheckBox honor the accent without per-widget tinting. -->
    <style name="Theme.KiberQalqon.Anor" parent="Theme.KiberQalqon">
        <item name="kqPrimary">@color/kq_anor</item>
        <item name="kqPrimary2">@color/kq_anor_2</item>
        <item name="kqPrimarySoft">@color/kq_anor_soft</item>
        <item name="colorPrimary">@color/kq_anor</item>
        <item name="colorPrimaryVariant">@color/kq_anor_2</item>
        <item name="colorAccent">@color/kq_anor</item>
        <item name="colorControlActivated">@color/kq_anor</item>
    </style>

    <style name="Theme.KiberQalqon.Feruz" parent="Theme.KiberQalqon">
        <item name="kqPrimary">@color/kq_feruz</item>
        <item name="kqPrimary2">@color/kq_feruz_2</item>
        <item name="kqPrimarySoft">@color/kq_feruz_soft</item>
        <item name="colorPrimary">@color/kq_feruz</item>
        <item name="colorPrimaryVariant">@color/kq_feruz_2</item>
        <item name="colorAccent">@color/kq_feruz</item>
        <item name="colorControlActivated">@color/kq_feruz</item>
    </style>

    <style name="Theme.KiberQalqon.Zafaron" parent="Theme.KiberQalqon">
        <item name="kqPrimary">@color/kq_zafaron</item>
        <item name="kqPrimary2">@color/kq_zafaron_2</item>
        <item name="kqPrimarySoft">@color/kq_zafaron_soft</item>
        <item name="colorPrimary">@color/kq_zafaron</item>
        <item name="colorPrimaryVariant">@color/kq_zafaron_2</item>
        <item name="colorAccent">@color/kq_zafaron</item>
        <item name="colorControlActivated">@color/kq_zafaron</item>
    </style>
</resources>
