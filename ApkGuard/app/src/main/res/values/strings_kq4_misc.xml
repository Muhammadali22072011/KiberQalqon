    <string name="kq4_misc_hidden_hint_admin">Xavfsizlik → Qurilma administratorlari → \"%1$s\" dan belgini oling. So\'ng o\'chiring.</string>
    <string name="kq4_misc_hidden_act_access">2) Accessibility\'ni o\'chirish</string>
    <string name="kq4_misc_hidden_hint_access">Maxsus imkoniyatlar → \"%1$s\" xizmatini o\'chiring.</string>
    <string name="kq4_misc_hidden_act_notif">Bildirishnoma kirishini o\'chirish</string>
