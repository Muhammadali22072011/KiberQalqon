<?xml version="1.0" encoding="utf-8"?>
<!-- Theme-aware input field: yengil fon + hairline border. bg_input_cyber dan farqi —
     bu light/dark ikkalasida ham to'g'ri ko'rinadi (qattiq navy emas). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/kq_bg_elev" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="@color/kq_hairline" />
</shape>
