<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F1F37" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#1E3A5F" />
        </shape>
    </item>
    <item android:left="0dp" android:width="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#00B4D8"
                android:endColor="#00F5FF" />
        </shape>
    </item>
</layer-list>
