<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-scan full-screen background. Always dark cyber gradient per §3.5,
  regardless of theme. Approximates: linear-gradient(180deg, #06141a → #02080b)
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#1B0D12"
        android:endColor="#0B0608"
        android:type="linear" />
</shape>
