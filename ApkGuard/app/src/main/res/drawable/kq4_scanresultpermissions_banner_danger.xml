<?xml version="1.0" encoding="utf-8"?>
<!-- ScanResult banner — DANGER: gradient danger → quyuq qizil, pastki burchaklar r26.
     kq4_banner_danger.xml nusxasi, lekin tuzatilgan burchak bilan: GradientDrawable
     android:angle faqat 45 ga karrali qiymat qabul qiladi — CSS 160deg ≈ 290 emas,
     eng yaqin ruxsat etilgani 315 (aks holda inflate'da Resources$NotFoundException). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="315" android:startColor="@color/kq_danger" android:endColor="#8E1D12" />
    <corners android:bottomLeftRadius="26dp" android:bottomRightRadius="26dp" />
</shape>
