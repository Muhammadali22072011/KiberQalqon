<?xml version="1.0" encoding="utf-8"?>
<!-- C2 marker — danger dot with halo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#40D74536" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/kq_danger" />
        </shape>
    </item>
</layer-list>
