<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#0E0E12" />
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape>
            <size android:height="2dp" />
            <gradient
                android:angle="0"
                android:startColor="#00C2143D"
                android:centerColor="#C2143D"
                android:endColor="#00C2143D"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
