<?xml version="1.0" encoding="utf-8"?>
<!--
  Active pager dot. CSS sets width:22, height:8, radius:50%. A pure rounded rect
  with corner radius 4dp gives the same pill shape; the Activity sets the
  per-dot width to 22dp at runtime.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/kq_primary" />
    <corners android:radius="4dp" />
</shape>
