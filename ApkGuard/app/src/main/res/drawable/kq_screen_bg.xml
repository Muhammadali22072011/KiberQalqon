<?xml version="1.0" encoding="utf-8"?>
<!-- Фон экрана по макету (.s1: gradient #1b0d12 → #141319) — лёгкий anor-отлив
     сверху, уходящий в фон. @color-литералы дают корректные light/dark пары:
     dark #2C141E→#141319, light #FBE9EE→#FBF8F3. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/kq_anor_soft"
        android:endColor="@color/kq_bg"
        android:centerY="0.45"
        android:centerColor="@color/kq_bg"
        android:type="linear" />
</shape>
