<?xml version="1.0" encoding="utf-8"?>
<!--
  KiberQalqon brand mark = shield + APK box silhouette + checkmark badge.
  Updated 2026-05-22 — раньше был щит со звездой, теперь связан с APK защитой.
   - shield body (kq_primary — берёт текущий accent из темы)
   - APK rounded box (телефон-силуэт) внутри щита, белый
   - "APK" буквы стилизованные внутри бокса
   - checkmark-badge сверху бокса = "проверено"
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Shield body — rounded modern silhouette -->
    <path
        android:pathData="M50 4 L88 16 V48 C88 72 72 90 50 96 C28 90 12 72 12 48 V16 Z"
        android:fillColor="@color/kq_primary" />

    <!-- APK box (rounded rectangle = phone/app silhouette) inside the shield -->
    <path
        android:pathData="M36 40 L64 40 A 4 4 0 0 1 68 44 L68 72 A 4 4 0 0 1 64 76 L36 76 A 4 4 0 0 1 32 72 L32 44 A 4 4 0 0 1 36 40 Z"
        android:fillColor="#FFFFFF" />

    <!-- "APK" letters inside the white box -->
    <!-- A -->
    <path
        android:pathData="M38 64 L41 50 L44 64 M39 59 L43 59"
        android:strokeColor="@color/kq_primary"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- P -->
    <path
        android:pathData="M47 64 L47 50 L53 50 A 3 3 0 0 1 53 56 L47 56"
        android:strokeColor="@color/kq_primary"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- K -->
    <path
        android:pathData="M57 64 L57 50 M57 57 L62 50 M57 57 L62 64"
        android:strokeColor="@color/kq_primary"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Checkmark badge — small white circle top-right of the box (verified) -->
    <path
        android:pathData="M68 36 m -8 0 a 8 8 0 1 0 16 0 a 8 8 0 1 0 -16 0"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M64 36 L67 39 L72 33"
        android:strokeColor="@color/kq_primary"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
