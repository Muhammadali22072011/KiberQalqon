<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashboard hero card (Yorug' minimal): soft white -> faint turquoise wash.
  NOTE: gradient start/endColor must be LITERAL colors. A `?attr/` theme
  attribute (or a ColorStateList that indirects to one, like
  @color/kq_primary_soft) does NOT resolve inside <gradient> and renders as
  a magenta fallback on the device. Use kq_feruz_soft directly.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/kq_bg_elev"
        android:endColor="@color/kq_feruz_soft"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/kq_hairline_strong" />
    <corners android:radius="28dp" />
</shape>
