<?xml version="1.0" encoding="utf-8"?>
<!--
  Inverted brand mark — белый щит + красный APK бокс. Для splash где фон
  турчуазный gradient. Mirror of kq_shield_mark.xml но цвета поменяны местами.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Shield body — white (slight alpha so it sits on coloured bg) -->
    <path
        android:pathData="M50 4 L88 16 V48 C88 72 72 90 50 96 C28 90 12 72 12 48 V16 Z"
        android:fillColor="#F2FFFFFF" />

    <!-- APK box — turquoise (matches splash gradient) -->
    <path
        android:pathData="M36 40 L64 40 A 4 4 0 0 1 68 44 L68 72 A 4 4 0 0 1 64 76 L36 76 A 4 4 0 0 1 32 72 L32 44 A 4 4 0 0 1 36 40 Z"
        android:fillColor="@color/kq_primary_light" />

    <!-- "APK" letters white inside the colored box -->
    <path
        android:pathData="M38 64 L41 50 L44 64 M39 59 L43 59"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M47 64 L47 50 L53 50 A 3 3 0 0 1 53 56 L47 56"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M57 64 L57 50 M57 57 L62 50 M57 57 L62 64"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Checkmark badge - white circle, turquoise check -->
    <path
        android:pathData="M68 36 m -8 0 a 8 8 0 1 0 16 0 a 8 8 0 1 0 -16 0"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M64 36 L67 39 L72 33"
        android:strokeColor="@color/kq_primary_light"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
