<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1100B4D8" />
            <size android:width="240dp" android:height="240dp" />
        </shape>
    </item>
    <item android:left="20dp" android:top="20dp" android:right="20dp" android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#2200B4D8" />
        </shape>
    </item>
    <item android:left="40dp" android:top="40dp" android:right="40dp" android:bottom="40dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="120"
                android:startColor="#5500B4D8"
                android:endColor="#0077B6" />
            <stroke android:width="2dp" android:color="#48CAE4" />
        </shape>
    </item>
</layer-list>
