<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#11C2143D" />
            <size android:width="240dp" android:height="240dp" />
        </shape>
    </item>
    <item android:left="20dp" android:top="20dp" android:right="20dp" android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#22C2143D" />
        </shape>
    </item>
    <item android:left="40dp" android:top="40dp" android:right="40dp" android:bottom="40dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="120"
                android:startColor="#55C2143D"
                android:endColor="#8E0E2C" />
            <stroke android:width="2dp" android:color="#E11D48" />
        </shape>
    </item>
</layer-list>
