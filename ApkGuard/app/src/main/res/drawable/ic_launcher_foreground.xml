<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground. Adaptive icon канвас 108×108dp, safe zone 72×72
  (центральный диаметр 66dp). Поэтому всё рисуем в центре, отступив от краёв.

  Дизайн = совпадает с kq_shield_mark.xml но скейл оптимизирован под
  лаунчер-иконку (большой щит, читаемый APK-блок, чекмарк-бадж).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield body — fills safe zone. -->
    <path
        android:pathData="M54 24 L88 34 V60 C88 80 74 92 54 96 C34 92 20 80 20 60 V34 Z"
        android:fillColor="#C13A28" />

    <!-- Subtle highlight stroke -->
    <path
        android:pathData="M54 27 L85 36 V58 C85 76 72 87 54 91 C36 87 23 76 23 58 V36 Z"
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="0.8"
        android:fillColor="#00000000" />

    <!-- APK box inside the shield -->
    <path
        android:pathData="M40 51 L68 51 A 3.5 3.5 0 0 1 71.5 54.5 L71.5 78 A 3.5 3.5 0 0 1 68 81.5 L40 81.5 A 3.5 3.5 0 0 1 36.5 78 L36.5 54.5 A 3.5 3.5 0 0 1 40 51 Z"
        android:fillColor="#FFFFFF" />

    <!-- "APK" letters -->
    <path
        android:pathData="M42 71 L45 58 L48 71 M43 66 L47 66"
        android:strokeColor="#C13A28"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M51 71 L51 58 L57 58 A 3 3 0 0 1 57 64 L51 64"
        android:strokeColor="#C13A28"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M61 71 L61 58 M61 65 L66 58 M61 65 L66 71"
        android:strokeColor="#C13A28"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Checkmark badge top-right (verified) -->
    <path
        android:pathData="M72 47 m -7 0 a 7 7 0 1 0 14 0 a 7 7 0 1 0 -14 0"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M68.5 47 L71 49.5 L75.5 44.5"
        android:strokeColor="#C13A28"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
