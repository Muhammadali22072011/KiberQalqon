<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash background, linear gradient between kq_primary_light and kq_primary_2_light.
  CSS source: linear-gradient(160deg, primary 0%, primary-2 100%); 160deg maps to
  top-right to bottom-left, which is android:angle=290.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/kq_primary_light"
        android:endColor="@color/kq_primary_2_light"
        android:type="linear" />
</shape>
