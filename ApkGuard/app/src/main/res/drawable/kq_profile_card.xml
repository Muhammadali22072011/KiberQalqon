<?xml version="1.0" encoding="utf-8"?>
<!-- Settings profile card — gradient kq_bg_elev → faint turquoise. §3.7
     Literal kq_feruz_soft, not @color/kq_primary_soft: a ?attr/-backed
     ColorStateList renders magenta inside <gradient>. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/kq_bg_elev"
        android:endColor="@color/kq_feruz_soft"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/kq_hairline_strong" />
    <corners android:radius="22dp" />
</shape>
