<?xml version="1.0" encoding="utf-8"?>
<!-- Small stat tile in the dashboard 3-up row. 16dp radius, hairline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/kq_bg_elev" />
    <stroke android:width="1dp" android:color="@color/kq_hairline" />
    <corners android:radius="16dp" />
</shape>
