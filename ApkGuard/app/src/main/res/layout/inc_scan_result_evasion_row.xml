<?xml version="1.0" encoding="utf-8"?>
<!--
  Single row inside the "Anti-tahlil hiylalari" card. §3.6 — 44dp warn-bg icon
  tile + title + description (NOT truncated). Populated by Kotlin per sample.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:gravity="top"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/kq_icon_tile_warn">

        <ImageView
            android:id="@+id/ivEvasionIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_warning_alert"
            app:tint="@color/kq_warn_ink" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEvasionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZIP-evasion"
            android:textColor="@color/kq_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEvasionDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="1.45"
            android:text="Har bir fayl GP-flag=0x01 (encrypted) ko'rsatilgan. Antiviruslar ocha olmaydi, lekin Android o'rnatadi."
            android:textColor="@color/kq_ink_2"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
