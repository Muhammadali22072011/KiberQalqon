<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 Stats — «Topilgan fayllar» kartasidagi bitta qator (.li dizayni):
  av 42dp (kq4_av_danger + ic4_file 20dp) · nomi · manba · vaqt · tag danger.
  ScanHistoryActivity.bindThreatList() inflate qiladi; SUSPICIOUS bo'lsa
  warn rangiga kodda almashtiriladi. Pastdagi divider oxirgi qatorda yashiriladi.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="15dp"
        android:paddingVertical="14dp">

        <!-- .av danger 42dp -->
        <FrameLayout
            android:id="@+id/avWrap"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/kq4_av_danger">

            <ImageView
                android:id="@+id/ivAvIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic4_file"
                app:tint="@color/kq_danger" />
        </FrameLayout>

        <!-- ttl + sub -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                style="@style/KQ4.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvSub"
                style="@style/KQ4.RowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <!-- .tag danger (dot + matn) -->
        <LinearLayout
            android:id="@+id/tagWrap"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="13dp"
            android:background="@drawable/kq4_tag_danger"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <View
                android:id="@+id/tagDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/kq4_dot"
                android:backgroundTint="@color/kq_danger_ink" />

            <TextView
                android:id="@+id/tagVerdict"
                style="@style/KQ4.Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/kq4_danger"
                android:textColor="@color/kq_danger_ink" />
        </LinearLayout>
    </LinearLayout>

    <!-- .li border-bottom -->
    <View
        android:id="@+id/vDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/kq_hairline" />
</LinearLayout>
