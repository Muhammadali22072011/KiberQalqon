<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 Himoya holati qatori: .li (av 44 safe/warn + sarlavha/izoh) + o'ngda
  yo "Yoniq" tag (safe, nuqta bilan), yo 36dp "Yoqish" tugmasi + hairline.
  Holat (av fon, ikonka tint, tag/tugma) Kotlin'dan boshqariladi.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowProt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="15dp"
        android:paddingTop="14dp"
        android:paddingEnd="15dp"
        android:paddingBottom="14dp">

        <!-- av 44: ok → kq4_av_safe, aks holda → kq4_av_warn -->
        <FrameLayout
            android:id="@+id/avProt"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/kq4_av_safe">

            <ImageView
                android:id="@+id/imgProtRowIcon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/kq_safe" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProtRowTitle"
                style="@style/KQ4.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvProtRowSub"
                style="@style/KQ4.RowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- ok → .tag safe (nuqta + "Yoniq") -->
        <LinearLayout
            android:id="@+id/tagProtOn"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/kq4_tag_safe"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/kq4_dot"
                android:backgroundTint="@color/kq_safe_ink" />

            <TextView
                style="@style/KQ4.Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/kq4_on"
                android:textColor="@color/kq_safe_ink" />
        </LinearLayout>

        <!-- yo'q → btn sm primary 36dp "Yoqish" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProtEnable"
            style="@style/KQ4.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/kq4_enable"
            android:textSize="14.5sp"
            android:visibility="gone"
            app:cornerRadius="18dp" />
    </LinearLayout>

    <View
        android:id="@+id/divProt"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/kq_hairline" />
</LinearLayout>
