<?xml version="1.0" encoding="utf-8"?>
<!--
  Yangiliklar lentasidagi bitta e'lon. MainActivity item_news'ni newsContainer
  ichiga inflate qiladi va bog'laydi:
    newsAccent  — chap chiziq, rang darajaga qarab (info/warning/critical)
    newsItemTitle / newsItemDate — sarlavha + sana
    newsItemBody  — matn (bo'sh bo'lsa gone)
    newsItemImage — rasm (havola bo'lsa, bitmap kodda qo'yiladi; aks holda gone)
    newsItemDivider — pastki hairline (oxirgi elementda gone qilinadi)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <View
            android:id="@+id/newsAccent"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:background="@color/kq_ink_3" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/newsItemTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Sarlavha"
                    android:textColor="@color/kq_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/newsItemDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:text=""
                    android:textColor="@color/kq_ink_3"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/newsItemBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.4"
                android:text=""
                android:textColor="@color/kq_ink_2"
                android:textSize="13sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/newsItemImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:maxHeight="200dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/newsItemDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@color/kq_hairline" />
</LinearLayout>
