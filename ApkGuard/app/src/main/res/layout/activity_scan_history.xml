<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 «Milliy Kiber Himoya» — Stats / «Statistika» vkladkasi (screens2.jsx → Stats).

  Tartib: eyebrow STATISTIKA + h-title «So'nggi 7 kun» → 2 stat-karta (34sp raqam)
  → grafik kartasi (7 ustun, 104dp maydon, badge 18dp) → «Qanday xavflar topildi»
  (kategoriya progresslari 9dp/r5) → «Topilgan fayllar» (.li qatorlar,
  item_scan_history.xml dan inflate) → ghost «Hisobotni yangilash» + «Tarixni
  tozalash» → pastki navigatsiya.

  Hamma raqam/balandlik/ro'yxat JONLI bog'lanadi (ScanHistoryActivity):
  uzguard_stats prefs (total_scanned / total_blocked / day_0..6+epochday,
  staleness bilan) va ScanHistory.all(). Ustun balandliklari LayoutParams orqali
  kodda qo'yiladi (dizayn: 12% minimal + 78% proporsional).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="92dp"
        android:scrollbars="none">

        <!-- .screen-pad: 14 / 18 / 30 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="30dp">

            <!-- ▌ eyebrow + h-title -->
            <TextView
                style="@style/KQ4.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hist_section_stats" />

            <TextView
                style="@style/KQ4.HTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hist_period_last_7_days" />

            <!-- ▌ 2 stat-karta (grid 1fr 1fr, gap 10) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/KQ4.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvStatsTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/onest_extrabold"
                            android:letterSpacing="-0.03"
                            android:text="0"
                            android:textColor="@color/kq_ink"
                            android:textSize="34sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/onest_medium"
                            android:lineSpacingMultiplier="1.3"
                            android:text="@string/kq4_stats_scanned_files"
                            android:textColor="@color/kq_ink_3"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/KQ4.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvStatsBlocked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/onest_extrabold"
                            android:letterSpacing="-0.03"
                            android:text="0"
                            android:textColor="@color/kq_danger"
                            android:textSize="34sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/onest_medium"
                            android:lineSpacingMultiplier="1.3"
                            android:text="@string/kq4_stats_found_removed"
                            android:textColor="@color/kq_ink_3"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ▌ Grafik kartasi -->
            <com.google.android.material.card.MaterialCardView
                style="@style/KQ4.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- between: sec-title 15 + tag outline -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/KQ4.SecTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/kq4_stats_daily_checks"
                            android:textSize="15sp" />

                        <TextView
                            style="@style/KQ4.Tag"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:background="@drawable/kq4_tag_outline"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:text="@string/kq4_stats_week"
                            android:textColor="@color/kq_ink_2" />
                    </LinearLayout>

                    <!-- 7 ustun: maydon 104dp, gap 8; balandliklar kodda -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Du -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="104dp">

                                <TextView
                                    android:id="@+id/barBadge1"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="top|center_horizontal"
                                    android:background="@drawable/kq4_circle_danger"
                                    android:fontFamily="@font/onest_bold"
                                    android:gravity="center"
                                    android:text="0"
                                    android:textColor="@color/white"
                                    android:textSize="10sp"
                                    android:visibility="gone" />

                                <View
                                    android:id="@+id/bar1"
                                    android:layout_width="match_parent"
                                    android:layout_height="13dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/kq4_stats_bar" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/ssmono_medium"
                                android:text="@string/kq4_stats_day_mon"
                                android:textColor="@color/kq_ink_3"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Se -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="104dp">

                                <TextView
                                    android:id="@+id/barBadge2"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="top|center_horizontal"
                                    android:background="@drawable/kq4_circle_danger"
                                    android:fontFamily="@font/onest_bold"
                                    android:gravity="center"
                                    android:text="0"
                                    android:textColor="@color/white"
                                    android:textSize="10sp"
                                    android:visibility="gone" />

                                <View
                                    android:id="@+id/bar2"
                                    android:layout_width="match_parent"
                                    android:layout_height="13dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/kq4_stats_bar" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/ssmono_medium"
                                android:text="@string/kq4_stats_day_tue"
                                android:textColor="@color/kq_ink_3"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Cho -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="104dp">

                                <TextView
                                    android:id="@+id/barBadge3"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="top|center_horizontal"
                                    android:background="@drawable/kq4_circle_danger"
                                    android:fontFamily="@font/onest_bold"
                                    android:gravity="center"
                                    android:text="0"
                                    android:textColor="@color/white"
                                    android:textSize="10sp"
                                    android:visibility="gone" />

                                <View
                                    android:id="@+id/bar3"
                                    android:layout_width="match_parent"
                                    android:layout_height="13dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/kq4_stats_bar" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/ssmono_medium"
                                android:text="@string/kq4_stats_day_wed"
                                android:textColor="@color/kq_ink_3"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Pa -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="104dp">

                                <TextView
                                    android:id="@+id/barBadge4"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="top|center_horizontal"
                                    android:background="@drawable/kq4_circle_danger"
                                    android:fontFamily="@font/onest_bold"
                                    android:gravity="center"
                                    android:text="0"
                                    android:textColor="@color/white"
                                    android:textSize="10sp"
                                    android:visibility="gone" />

                                <View
                                    android:id="@+id/bar4"
                                    android:layout_width="match_parent"
                                    android:layout_height="13dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/kq4_stats_bar" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/ssmono_medium"
                                android:text="@string/kq4_stats_day_thu"
                                android:textColor="@color/kq_ink_3"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Ju -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="104dp">

                                <TextView
                                    android:id="@+id/barBadge5"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="top|center_horizontal"
                                    android:background="@drawable/kq4_circle_danger"
                                    android:fontFamily="@font/onest_bold"
                                    android:gravity="center"
                                    android:text="0"
                                    android:textColor="@color/white"
                                    android:textSize="10sp"
                                    android:visibility="gone" />

                                <View
                                    android:id="@+id/bar5"
                                    android:layout_width="match_parent"
                                    android:layout_height="13dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/kq4_stats_bar" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/ssmono_medium"
                                android:text="@string/kq4_stats_day_fri"
                                android:textColor="@color/kq_ink_3"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Sh -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="104dp">

                                <TextView
                                    android:id="@+id/barBadge6"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="top|center_horizontal"
                                    android:background="@drawable/kq4_circle_danger"
                                    android:fontFamily="@font/onest_bold"
                                    android:gravity="center"
                                    android:text="0"
                                    android:textColor="@color/white"
                                    android:textSize="10sp"
                                    android:visibility="gone" />

                                <View
                                    android:id="@+id/bar6"
                                    android:layout_width="match_parent"
                                    android:layout_height="13dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/kq4_stats_bar" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/ssmono_medium"
                                android:text="@string/kq4_stats_day_sat"
                                android:textColor="@color/kq_ink_3"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Ya -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="104dp">

                                <TextView
                                    android:id="@+id/barBadge7"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="top|center_horizontal"
                                    android:background="@drawable/kq4_circle_danger"
                                    android:fontFamily="@font/onest_bold"
                                    android:gravity="center"
                                    android:text="0"
                                    android:textColor="@color/white"
                                    android:textSize="10sp"
                                    android:visibility="gone" />

                                <View
                                    android:id="@+id/bar7"
                                    android:layout_width="match_parent"
                                    android:layout_height="13dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/kq4_stats_bar" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/ssmono_medium"
                                android:text="@string/kq4_stats_day_sun"
                                android:textColor="@color/kq_ink_3"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ▌ Qanday xavflar topildi -->
            <TextView
                style="@style/KQ4.SecTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp"
                android:text="@string/kq4_stats_threat_types"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/KQ4.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Bank o'g'irlash (danger) -->
                    <LinearLayout
                        android:id="@+id/rowCat1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="7dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/onest_semibold"
                                android:text="@string/kq4_stats_cat_bank"
                                android:textColor="@color/kq_ink"
                                android:textSize="13.5sp" />

                            <TextView
                                android:id="@+id/tvCatCount1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/ssmono_medium"
                                android:text="0 / 0"
                                android:textColor="@color/kq_ink_3"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="9dp"
                            android:background="@drawable/kq4_stats_track">

                            <View
                                android:id="@+id/vCatFill1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="@drawable/kq4_stats_fill_danger" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Yashirin yuklash (danger) -->
                    <LinearLayout
                        android:id="@+id/rowCat2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="7dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/onest_semibold"
                                android:text="@string/kq4_stats_cat_dropper"
                                android:textColor="@color/kq_ink"
                                android:textSize="13.5sp" />

                            <TextView
                                android:id="@+id/tvCatCount2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/ssmono_medium"
                                android:text="0 / 0"
                                android:textColor="@color/kq_ink_3"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="9dp"
                            android:background="@drawable/kq4_stats_track">

                            <View
                                android:id="@+id/vCatFill2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="@drawable/kq4_stats_fill_danger" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Soxta SMS (warn) -->
                    <LinearLayout
                        android:id="@+id/rowCat3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="7dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/onest_semibold"
                                android:text="@string/kq4_stats_cat_sms"
                                android:textColor="@color/kq_ink"
                                android:textSize="13.5sp" />

                            <TextView
                                android:id="@+id/tvCatCount3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/ssmono_medium"
                                android:text="0 / 0"
                                android:textColor="@color/kq_ink_3"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="9dp"
                            android:background="@drawable/kq4_stats_track">

                            <View
                                android:id="@+id/vCatFill3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="@drawable/kq4_stats_fill_warn" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Boshqa (warn) — 0 bo'lsa kodda yashiriladi -->
                    <LinearLayout
                        android:id="@+id/rowCat4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="7dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/onest_semibold"
                                android:text="@string/kq4_stats_cat_other"
                                android:textColor="@color/kq_ink"
                                android:textSize="13.5sp" />

                            <TextView
                                android:id="@+id/tvCatCount4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/ssmono_medium"
                                android:text="0 / 0"
                                android:textColor="@color/kq_ink_3"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="9dp"
                            android:background="@drawable/kq4_stats_track">

                            <View
                                android:id="@+id/vCatFill4"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="@drawable/kq4_stats_fill_warn" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ▌ Topilgan fayllar -->
            <TextView
                style="@style/KQ4.SecTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="@string/kq4_stats_found_files"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/KQ4.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Bo'sh holat -->
                    <TextView
                        android:id="@+id/tvThreatsEmpty"
                        style="@style/KQ4.RowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="28dp"
                        android:text="@string/hist_no_threats_yet" />

                    <!-- .li qatorlar — item_scan_history.xml dan inflate qilinadi -->
                    <LinearLayout
                        android:id="@+id/listThreats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ▌ btn ghost block -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefresh"
                style="@style/KQ4.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hist_button_refresh_report"
                app:icon="@drawable/ic4_refresh"
                app:iconSize="19dp" />

            <!-- Tarixni tozalash — eski funksiya saqlanadi (dialog + clear) -->
            <TextView
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="@font/onest_semibold"
                android:padding="12dp"
                android:text="@string/history_clear"
                android:textColor="@color/kq_ink_3"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Pastki navigatsiya — KqBottomNav.attach(this, STATS) onCreate'da -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <include layout="@layout/view_kq_bottom_nav" />
    </FrameLayout>
</FrameLayout>
