<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Big shield with rings -->
    <FrameLayout
        android:layout_width="280dp"
        android:layout_height="280dp">

        <ImageView
            android:id="@+id/glowBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.5"
            android:background="@drawable/bg_scan_pulse_safe"
            android:contentDescription="Glow" />

        <ImageView
            android:id="@+id/radarBg"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            android:alpha="0.5"
            android:contentDescription="Radar"
            android:src="@drawable/ic_radar_scan" />

        <ImageView
            android:id="@+id/imgOnboarding"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:contentDescription="Onboarding"
            android:src="@drawable/ic_shield_glow" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:letterSpacing="0.02"
        android:text="@string/onboarding_title_1"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <View
        android:layout_width="70dp"
        android:layout_height="2dp"
        android:layout_marginTop="14dp"
        android:background="@color/primary_neon" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:text="@string/onboarding_desc_1"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />
</LinearLayout>
