<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashboard / Asosiy — v4 «Milliy Kiber Himoya» (design_v4_extracted/screens1.jsx → Dashboard).

  Tuzilma: ScrollView (clipToPadding=false, paddingBottom 90dp)
    └ inc_kq4_topbar (logo + holat + UZ/RU + qo'ng'iroqcha)
    └ dashboardContent (.screen-pad 18dp):
        HERO (KQ4.Card: KqRingView 158 + holat + CTA) →
        3 raqam kartasi → "Bugun bloklangan" → "Himoya qatlamlari" 2×2 →
        "Qurilma ilovalari" (dizaynda yo'q, funksiya saqlanadi).
  Pastda — umumiy view_kq_bottom_nav (KqBottomNav.attach → HOME).
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingBottom="90dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- ▌ v4 TopBar (umumiy include — fayli o'zgartirilmaydi) -->
            <include
                android:id="@+id/kq4Topbar"
                layout="@layout/inc_kq4_topbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/dashboardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="4dp"
                android:paddingBottom="30dp">

                <!-- ╔═══ HERO ═══╗ ring 158 + holat sarlavhasi + so'nggi tekshiruv + CTA -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/KQ4.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- dekorativ 8 qirrali yulduz ornamenti (design .pattern, alpha .05) -->
                        <ImageView
                            android:layout_width="78dp"
                            android:layout_height="78dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="14dp"
                            android:layout_marginEnd="10dp"
                            android:alpha="0.05"
                            android:contentDescription="@null"
                            android:src="@drawable/kq4_star" />

                        <ImageView
                            android:layout_width="78dp"
                            android:layout_height="78dp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="40dp"
                            android:alpha="0.05"
                            android:contentDescription="@null"
                            android:src="@drawable/kq4_star" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="26dp"
                            android:paddingBottom="20dp"
                            android:paddingHorizontal="20dp">

                            <FrameLayout
                                android:layout_width="158dp"
                                android:layout_height="158dp">

                                <com.kiberqalqon.KqRingView
                                    android:id="@+id/kq4DashRing"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />

                                <ImageView
                                    android:id="@+id/kq4DashHeroIcon"
                                    android:layout_width="54dp"
                                    android:layout_height="54dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic4_shield_check"
                                    app:tint="@color/kq_safe" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/kq4DashHeroTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:fontFamily="@font/onest_bold"
                                android:gravity="center"
                                android:letterSpacing="-0.025"
                                android:text="@string/kq4_dash_hero_safe"
                                android:textColor="@color/kq_ink"
                                android:textSize="25sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic4_clock"
                                    app:tint="@color/kq_ink_3" />

                                <TextView
                                    android:id="@+id/kq4DashLastScan"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/onest_medium"
                                    android:text="@string/kq4_dash_last_scan"
                                    android:textColor="@color/kq_ink_3"
                                    android:textSize="13.5sp" />
                            </LinearLayout>

                            <!-- CTA: katta primary "Hozir tekshirish" + 58dp refresh -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnQuickScan"
                                    style="@style/KQ4.Button.Primary"
                                    android:layout_width="0dp"
                                    android:layout_height="58dp"
                                    android:layout_weight="1"
                                    android:minHeight="58dp"
                                    android:text="@string/kq4_dash_scan_now"
                                    android:textSize="17sp"
                                    app:icon="@drawable/ic4_scan"
                                    app:iconSize="20dp" />

                                <FrameLayout
                                    android:id="@+id/btnRefresh"
                                    android:layout_width="58dp"
                                    android:layout_height="58dp"
                                    android:layout_marginStart="10dp"
                                    android:background="@drawable/kq4_dash_iconbtn24"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@string/kq4_dash_refresh"
                                        android:src="@drawable/ic4_refresh"
                                        app:tint="@color/kq_ink_2" />
                                </FrameLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ▌ YANGILIKLAR — bulut e'lonlari karuseli (NewsStore /api/news).
                     Kesh ham, tarmoq ham bo'sh bo'lsa butun seksiya GONE qoladi —
                     bulutga ulanmagan qurilmada foydalanuvchi bo'sh blok ko'rmaydi. -->
                <LinearLayout
                    android:id="@+id/kq4NewsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/KQ4.Eyebrow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/kq4_news_eyebrow" />

                        <TextView
                            android:id="@+id/kq4NewsAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/onest_semibold"
                            android:padding="4dp"
                            android:text="@string/kq4_all"
                            android:textColor="@color/kq_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/kq4NewsPager"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:id="@+id/kq4NewsDots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- ▌ 3 raqam kartasi: Tekshirildi / O'chirildi / Himoya % -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tileScanned"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/kq4_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="15dp">

                        <TextView
                            android:id="@+id/tvTotalScanned"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/onest_extrabold"
                            android:letterSpacing="-0.03"
                            android:text="0"
                            android:textColor="@color/kq_ink"
                            android:textSize="26sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="@font/onest_medium"
                            android:text="@string/kq4_dash_stat_scanned"
                            android:textColor="@color/kq_ink_3"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tileDeleted"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/kq4_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="15dp">

                        <TextView
                            android:id="@+id/tvTotalBlocked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/onest_extrabold"
                            android:letterSpacing="-0.03"
                            android:text="0"
                            android:textColor="@color/kq_danger"
                            android:textSize="26sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="@font/onest_medium"
                            android:text="@string/kq4_dash_stat_deleted"
                            android:textColor="@color/kq_ink_3"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tileProtection"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/kq4_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="15dp">

                        <TextView
                            android:id="@+id/tvProtectionPct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/onest_extrabold"
                            android:letterSpacing="-0.03"
                            android:text="0"
                            android:textColor="@color/kq_safe"
                            android:textSize="26sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="@font/onest_medium"
                            android:text="@string/kq4_dash_stat_protection"
                            android:textColor="@color/kq_ink_3"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ▌ 2 ta tezkor tekshiruv plitkasi: Havola tekshiruvi / QR tekshiruvi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Havola (URL) tekshiruvi → LinkCheckActivity -->
                    <LinearLayout
                        android:id="@+id/tileLinkCheck"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/kq4_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="15dp">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/kq4_av_primary">

                            <ImageView
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic4_link"
                                app:tint="@color/kq_primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:fontFamily="@font/onest_bold"
                            android:letterSpacing="-0.01"
                            android:text="@string/kq4_dash_tile_link"
                            android:textColor="@color/kq_ink"
                            android:textSize="14.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/onest_regular"
                            android:lineSpacingMultiplier="1.35"
                            android:text="@string/kq4_dash_tile_link_sub"
                            android:textColor="@color/kq_ink_3"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- QR-kod tekshiruvi → QrScanActivity -->
                    <LinearLayout
                        android:id="@+id/tileQrCheck"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/kq4_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="15dp">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/kq4_av_primary">

                            <ImageView
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic4_qr"
                                app:tint="@color/kq_primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:fontFamily="@font/onest_bold"
                            android:letterSpacing="-0.01"
                            android:text="@string/kq4_dash_tile_qr"
                            android:textColor="@color/kq_ink"
                            android:textSize="14.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/onest_regular"
                            android:lineSpacingMultiplier="1.35"
                            android:text="@string/kq4_dash_tile_qr_sub"
                            android:textColor="@color/kq_ink_3"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ▌ "Bugun bloklangan" + Hammasi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/KQ4.SecTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/kq4_dash_sec_blocked" />

                    <TextView
                        android:id="@+id/cardApkList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/onest_semibold"
                        android:padding="4dp"
                        android:text="@string/kq4_all"
                        android:textColor="@color/kq_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- bloklangan ro'yxati (3 tagacha real ScanHistory yozuvi) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/KQ4.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/threatRow1"
                            layout="@layout/inc_dashboard_threat_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <View
                            android:id="@+id/kq4ThreatDiv1"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/kq_hairline" />

                        <include
                            android:id="@+id/threatRow2"
                            layout="@layout/inc_dashboard_threat_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <View
                            android:id="@+id/kq4ThreatDiv2"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/kq_hairline" />

                        <include
                            android:id="@+id/threatRow3"
                            layout="@layout/inc_dashboard_threat_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ▌ "Himoya qatlamlari" 2×2 (data.jsx → GUARDS) -->
                <TextView
                    style="@style/KQ4.SecTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/kq4_dash_sec_guards" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Fayllar nazorati -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/kq4_card"
                        android:orientation="vertical"
                        android:padding="15dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_gravity="start|top"
                                android:background="@drawable/kq4_av_primary">

                                <ImageView
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic4_folder"
                                    app:tint="@color/kq_primary" />
                            </FrameLayout>

                            <View
                                android:id="@+id/kq4GuardFilesDot"
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_gravity="end|top"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/kq4_dot"
                                android:backgroundTint="@color/kq_safe" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:fontFamily="@font/onest_bold"
                            android:letterSpacing="-0.01"
                            android:text="@string/kq4_dash_guard_files_t"
                            android:textColor="@color/kq_ink"
                            android:textSize="14.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/onest_regular"
                            android:lineSpacingMultiplier="1.35"
                            android:text="@string/kq4_dash_guard_files_s"
                            android:textColor="@color/kq_ink_3"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Bank himoyasi → soxta bank ilovalari auditi (BankGuardActivity) -->
                    <LinearLayout
                        android:id="@+id/kq4GuardBankCell"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/kq4_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="15dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_gravity="start|top"
                                android:background="@drawable/kq4_av_primary">

                                <ImageView
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic4_card"
                                    app:tint="@color/kq_primary" />
                            </FrameLayout>

                            <View
                                android:id="@+id/kq4GuardBankDot"
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_gravity="end|top"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/kq4_dot"
                                android:backgroundTint="@color/kq_safe" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:fontFamily="@font/onest_bold"
                            android:letterSpacing="-0.01"
                            android:text="@string/kq4_dash_guard_bank_t"
                            android:textColor="@color/kq_ink"
                            android:textSize="14.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/onest_regular"
                            android:lineSpacingMultiplier="1.35"
                            android:text="@string/kq4_dash_guard_bank_s"
                            android:textColor="@color/kq_ink_3"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- SMS himoyasi -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/kq4_card"
                        android:orientation="vertical"
                        android:padding="15dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_gravity="start|top"
                                android:background="@drawable/kq4_av_primary">

                                <ImageView
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic4_message"
                                    app:tint="@color/kq_primary" />
                            </FrameLayout>

                            <View
                                android:id="@+id/kq4GuardSmsDot"
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_gravity="end|top"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/kq4_dot"
                                android:backgroundTint="@color/kq_warn" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:fontFamily="@font/onest_bold"
                            android:letterSpacing="-0.01"
                            android:text="@string/kq4_dash_guard_sms_t"
                            android:textColor="@color/kq_ink"
                            android:textSize="14.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/onest_regular"
                            android:lineSpacingMultiplier="1.35"
                            android:text="@string/kq4_dash_guard_sms_s"
                            android:textColor="@color/kq_ink_3"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Internet himoyasi -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/kq4_card"
                        android:orientation="vertical"
                        android:padding="15dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_gravity="start|top"
                                android:background="@drawable/kq4_av_primary">

                                <ImageView
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic4_globe"
                                    app:tint="@color/kq_primary" />
                            </FrameLayout>

                            <View
                                android:id="@+id/kq4GuardNetDot"
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_gravity="end|top"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/kq4_dot"
                                android:backgroundTint="@color/kq_warn" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:fontFamily="@font/onest_bold"
                            android:letterSpacing="-0.01"
                            android:text="@string/kq4_dash_guard_net_t"
                            android:textColor="@color/kq_ink"
                            android:textSize="14.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/onest_regular"
                            android:lineSpacingMultiplier="1.35"
                            android:text="@string/kq4_dash_guard_net_s"
                            android:textColor="@color/kq_ink_3"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ▌ "Qurilma ilovalari" (dizaynda yo'q — funksiya saqlanadi, .li uslubda) -->
                <TextView
                    style="@style/KQ4.SecTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/kq4_dash_sec_apps" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/KQ4.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/appList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Umumiy pastki navigatsiya — KqBottomNav.attach() onCreate'da HOME'ni faollashtiradi. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <include layout="@layout/view_kq_bottom_nav" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
