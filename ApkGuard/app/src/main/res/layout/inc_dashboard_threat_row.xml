<?xml version="1.0" encoding="utf-8"?>
<!--
  Single row inside the "Bugungi topilmalar" card on the dashboard.
  Mirrors §3.3 li-row: 44dp danger icon tile + filename/family stack + sev chip.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/kq_icon_tile_danger">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_virus"
            app:tint="@color/kq_danger_ink" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvThreatName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="RASMLAR (18).apk"
            android:textColor="@color/kq_ink"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvThreatSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="Ajina.Banker · Telegram · 12 daq oldin"
            android:textColor="@color/kq_ink_3"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvThreatSev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/kq_sev_crit"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="@string/kq_sev_crit"
        android:textColor="@color/kq_danger_ink"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
