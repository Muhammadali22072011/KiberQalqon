<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 TopBar (design screens1.jsx → TopBar):
  logo 40dp · brend nomi + yashil holat nuqtasi · o'ngda UZ/RU va qo'ng'iroqcha.
  ID'lar: kq4TopTitle, kq4TopSub, kq4TopDot, kq4BtnLang, kq4LangCode, kq4BtnBell.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingTop="6dp"
    android:paddingBottom="12dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/kq_logo_anor" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/kq4TopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/onest_bold"
            android:letterSpacing="-0.02"
            android:text="@string/kq4_brand"
            android:textColor="@color/kq_ink"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/kq4TopDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/kq4_dot"
                android:backgroundTint="@color/kq_safe" />

            <TextView
                android:id="@+id/kq4TopSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/onest_semibold"
                android:text="@string/kq4_protection_on"
                android:textColor="@color/kq_ink_3"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/kq4BtnLang"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/kq4_icon_btn"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/kq4LangCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/ssmono_bold"
            android:text="@string/kq4_lang_uz"
            android:textColor="@color/kq_ink_2"
            android:textSize="12sp" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/kq4BtnBell"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/kq4_icon_btn"
        android:contentDescription="@string/kq4_notifications"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic4_bell"
        app:tint="@color/kq_ink_2" />
</LinearLayout>
