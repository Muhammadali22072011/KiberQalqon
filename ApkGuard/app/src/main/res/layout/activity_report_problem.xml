<?xml version="1.0" encoding="utf-8"?>
<!--
  "Muammo haqida xabar" — v4 «Milliy Kiber Himoya» dizayni (screens2.jsx → Report).
  screen-pad: top 14 / horizontal 18 / bottom 30. Ikki holat:
  formGroup (textarea + maxfiylik kartasi + Yuborish) va sentGroup ("Rahmat!" kartasi).
  Animatsiyalar ReportProblemActivity da (cascade/shake/bounce).
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <!-- Sarlavha qatori: icon-btn back + eyebrow + h-title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/kq4_icon_btn"
                android:contentDescription="@string/kq4_back"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic4_back"
                app:tint="@color/kq_ink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/KQ4.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_eyebrow" />

                <TextView
                    style="@style/KQ4.HTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/kq4_report_title"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== Forma holati ===================== -->
        <LinearLayout
            android:id="@+id/formGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/KQ4.HSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/kq4_report_sub" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kq4_input"
                android:fontFamily="@font/onest_regular"
                android:gravity="top|start"
                android:hint="@string/rp_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingMultiplier="1.5"
                android:minHeight="140dp"
                android:padding="16dp"
                android:textColor="@color/kq_ink"
                android:textColorHint="@color/kq_ink_3"
                android:textSize="15sp" />

            <!-- Maxfiylik — card sunken -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/kq4_card_sunken"
                android:orientation="vertical"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic4_lock"
                        app:tint="@color/kq_ink_3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:fontFamily="@font/onest_semibold"
                        android:text="@string/kq4_report_privacy_title"
                        android:textColor="@color/kq_ink_2"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/onest_regular"
                    android:lineSpacingMultiplier="1.5"
                    android:text="@string/kq4_report_privacy_body"
                    android:textColor="@color/kq_ink_3"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSend"
                style="@style/KQ4.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minHeight="58dp"
                android:text="@string/rp_send"
                android:textSize="17sp"
                app:icon="@drawable/ic4_message"
                app:iconSize="19dp" />
        </LinearLayout>

        <!-- ===================== "Yuborildi" holati ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sentGroup"
            style="@style/KQ4.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="36dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic4_check_circle"
                    app:tint="@color/kq_safe" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/onest_bold"
                    android:text="@string/kq4_report_thanks"
                    android:textColor="@color/kq_ink"
                    android:textSize="18sp" />

                <TextView
                    style="@style/KQ4.HSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/kq4_report_sent_sub" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClose"
                    style="@style/KQ4.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="58dp"
                    android:text="@string/kq4_report_close"
                    android:textSize="17sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
