<?xml version="1.0" encoding="utf-8"?>
<!--
  NewsActivity to'liq ro'yxat kartasi: ixtiyoriy rasm (120dp) → "Qadab qo'yilgan"
  belgisi (faqat pinned) → sarlavha → to'liq matn → tag + sana.
  Pinned uslubi (primary-soft fon + primary ramka) NewsActivity'da kod bilan qo'yiladi.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kq4NewsRowCard"
    style="@style/KQ4.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/kq4NewsRowImg"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@color/kq_bg_sunken"
            android:contentDescription="@string/kq4_news_image_cd"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">

            <LinearLayout
                android:id="@+id/kq4NewsRowPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic4_star"
                    app:tint="@color/kq_primary_ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/onest_bold"
                    android:text="@string/kq4_news_pinned"
                    android:textColor="@color/kq_primary_ink"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/kq4NewsRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/onest_bold"
                android:letterSpacing="-0.01"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/kq_ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/kq4NewsRowBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/onest_regular"
                android:lineSpacingMultiplier="1.45"
                android:textColor="@color/kq_ink_2"
                android:textSize="13.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/kq4NewsRowTag"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/kq4_tag_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <View
                        android:id="@+id/kq4NewsRowTagDot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/kq4_dot"
                        android:backgroundTint="@color/kq_ink_2" />

                    <TextView
                        android:id="@+id/kq4NewsRowTagText"
                        style="@style/KQ4.Tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/kq4_news_level_info"
                        android:textColor="@color/kq_ink_2"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/kq4NewsRowDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/onest_medium"
                    android:textColor="@color/kq_ink_3"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
