<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 Settings chevron row (dizayn Row): 44dp av (kq4_av_primary) + ic4_* ikon +
  KQ4.RowTitle (+ixtiyoriy RowSub) + o'ngda chevron.
  Stable id'lar: ivChevronIcon, tvChevronTitle, tvChevronSub.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="15dp"
    android:paddingVertical="14dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/kq4_av_primary">

        <ImageView
            android:id="@+id/ivChevronIcon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic4_gear"
            app:tint="@color/kq_primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvChevronTitle"
            style="@style/KQ4.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_title" />

        <TextView
            android:id="@+id/tvChevronSub"
            style="@style/KQ4.RowSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@null"
        android:src="@drawable/ic4_chevron"
        app:tint="@color/kq_ink_3" />
</LinearLayout>
