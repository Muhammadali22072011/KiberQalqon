<?xml version="1.0" encoding="utf-8"?>
<!--
  Sozlamalar — v4 «Milliy Kiber Himoya» (screens2.jsx → Settings).
  screen-pad: 14/18/30, KQ4.Card kartochkalar, kq4_* drawable'lar, ic4_* ikonlar.
  Pastda umumiy navigatsiya (view_kq_bottom_nav) + KqBottomNav.attach(SETTINGS).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingHorizontal="18dp"
            android:paddingBottom="30dp">

            <!-- ── Sarlavha ── -->
            <TextView
                style="@style/KQ4.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kq4_set_eyebrow" />

            <TextView
                style="@style/KQ4.HTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="@string/kq4_set_title" />

            <!-- ── Profil kartochkasi ── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/KQ4.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- milliy yulduz naqshi (alpha .05) -->
                    <ImageView
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="86dp"
                        android:alpha="0.05"
                        android:contentDescription="@null"
                        android:src="@drawable/kq4_star" />

                    <ImageView
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="-30dp"
                        android:alpha="0.05"
                        android:contentDescription="@null"
                        android:src="@drawable/kq4_star" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:contentDescription="@null"
                            android:src="@drawable/kq_logo_anor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/onest_bold"
                                android:text="@string/kq4_brand"
                                android:textColor="@color/kq_ink"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tvProfileVersion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="@font/ssmono_medium"
                                android:letterSpacing="0.08"
                                android:text="@string/kq4_set_profile_version"
                                android:textColor="@color/kq_ink_3"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <!-- tag safe: nuqta + Faol -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:background="@drawable/kq4_tag_safe"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:layout_width="7dp"
                                android:layout_height="7dp"
                                android:contentDescription="@null"
                                android:src="@drawable/kq4_dot"
                                app:tint="@color/kq_safe_ink" />

                            <TextView
                                style="@style/KQ4.Tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:text="@string/kq4_set_active"
                                android:textColor="@color/kq_safe_ink" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════ HIMOYA ════ -->
            <TextView
                style="@style/KQ4.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="9dp"
                android:text="@string/kq4_set_sec_protection" />

            <com.google.android.material.card.MaterialCardView
                style="@style/KQ4.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowAutoScan"
                        layout="@layout/inc_settings_toggle_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <include
                        android:id="@+id/rowAutoDelete"
                        layout="@layout/inc_settings_toggle_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <include
                        android:id="@+id/rowPhishing"
                        layout="@layout/inc_settings_toggle_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <include
                        android:id="@+id/rowBackground"
                        layout="@layout/inc_settings_toggle_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════ KO'RINISH ════ -->
            <TextView
                style="@style/KQ4.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="9dp"
                android:text="@string/kq4_set_sec_appearance" />

            <com.google.android.material.card.MaterialCardView
                style="@style/KQ4.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Mavzu: av + matn ↔ sun/moon segment -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/kq4_av_primary">

                            <ImageView
                                android:id="@+id/ivThemeIcon"
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic4_sun"
                                app:tint="@color/kq_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="13dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/KQ4.RowTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/kq4_set_theme_title" />

                            <TextView
                                style="@style/KQ4.RowSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/kq4_set_theme_sub" />
                        </LinearLayout>

                        <!-- segment-pilyulya: 2 × (44×36) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/kq4_settings_seg_track"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <FrameLayout
                                android:id="@+id/segThemeLight"
                                android:layout_width="44dp"
                                android:layout_height="36dp"
                                android:background="@drawable/kq4_settings_seg_active">

                                <ImageView
                                    android:id="@+id/ivSegSun"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic4_sun"
                                    app:tint="@color/kq_on_primary" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/segThemeDark"
                                android:layout_width="44dp"
                                android:layout_height="36dp">

                                <ImageView
                                    android:id="@+id/ivSegMoon"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic4_moon"
                                    app:tint="@color/kq_ink_3" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/kq_hairline" />

                    <!-- Asosiy rang -->
                    <TextView
                        style="@style/KQ4.RowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/kq4_set_accent_title" />

                    <TextView
                        style="@style/KQ4.RowSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="@string/kq4_set_accent_sub" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Anor -->
                        <LinearLayout
                            android:id="@+id/accentPomegranate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/kq4_settings_swatch_sel"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="14dp">

                            <View
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="@drawable/kq4_settings_dot_anor" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:fontFamily="@font/onest_semibold"
                                android:text="@string/kq_accent_pomegranate"
                                android:textColor="@color/kq_ink"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <!-- Feruz -->
                        <LinearLayout
                            android:id="@+id/accentTurquoise"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/kq4_settings_swatch_idle"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="14dp">

                            <View
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="@drawable/kq4_settings_dot_feruz" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:fontFamily="@font/onest_semibold"
                                android:text="@string/kq_accent_turquoise"
                                android:textColor="@color/kq_ink"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <!-- Za'faron -->
                        <LinearLayout
                            android:id="@+id/accentSaffron"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/kq4_settings_swatch_idle"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="14dp">

                            <View
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="@drawable/kq4_settings_dot_zafaron" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:fontFamily="@font/onest_semibold"
                                android:text="@string/kq_accent_saffron"
                                android:textColor="@color/kq_ink"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════ TIL ════ -->
            <TextView
                style="@style/KQ4.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="9dp"
                android:text="@string/kq4_set_sec_language" />

            <com.google.android.material.card.MaterialCardView
                style="@style/KQ4.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowLangUz"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="14dp">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/kq4_av_primary">

                            <ImageView
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic4_globe"
                                app:tint="@color/kq_primary" />
                        </FrameLayout>

                        <TextView
                            style="@style/KQ4.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="13dp"
                            android:layout_weight="1"
                            android:text="@string/language_uzbek" />

                        <ImageView
                            android:id="@+id/ivLangUzState"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic4_check_circle"
                            app:tint="@color/kq_primary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <LinearLayout
                        android:id="@+id/rowLangRu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="14dp">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/kq4_av_primary">

                            <ImageView
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic4_globe"
                                app:tint="@color/kq_primary" />
                        </FrameLayout>

                        <TextView
                            style="@style/KQ4.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="13dp"
                            android:layout_weight="1"
                            android:text="@string/language_russian" />

                        <ImageView
                            android:id="@+id/ivLangRuState"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic4_chevron"
                            app:tint="@color/kq_ink_3" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════ HAQIDA ════ -->
            <TextView
                style="@style/KQ4.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="9dp"
                android:text="@string/kq4_set_sec_about" />

            <com.google.android.material.card.MaterialCardView
                style="@style/KQ4.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowAbout"
                        layout="@layout/inc_settings_chevron_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <include
                        android:id="@+id/rowHelp"
                        layout="@layout/inc_settings_chevron_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <include
                        android:id="@+id/rowReportProblem"
                        layout="@layout/inc_settings_chevron_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════ QO'SHIMCHA ════ -->
            <TextView
                style="@style/KQ4.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="9dp"
                android:text="@string/kq4_set_sec_extra" />

            <com.google.android.material.card.MaterialCardView
                style="@style/KQ4.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowUpload"
                        layout="@layout/inc_settings_toggle_row" />

                    <View
                        android:id="@+id/divServerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <!-- Server manzili (dialog orqali tahrirlanadi; faqat egasi rejimida ko'rinadi) -->
                    <LinearLayout
                        android:id="@+id/rowServerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="14dp">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/kq4_av_primary">

                            <ImageView
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic4_globe"
                                app:tint="@color/kq_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="13dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/KQ4.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_server_url_label" />

                            <TextView
                                android:id="@+id/etServerUrl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/ssmono_medium"
                                android:maxLines="1"
                                android:text="@string/settings_server_url_example"
                                android:textColor="@color/kq_ink_3"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="10dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic4_chevron"
                            app:tint="@color/kq_ink_3" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <include
                        android:id="@+id/rowHiddenThreats"
                        layout="@layout/inc_settings_chevron_row" />

                    <View
                        android:id="@+id/divTelegram"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <include
                        android:id="@+id/rowTelegram"
                        layout="@layout/inc_settings_chevron_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <include
                        android:id="@+id/rowProtectionStatus"
                        layout="@layout/inc_settings_chevron_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <!-- Bank ilovalari himoyasi (soxta bank skaneri) → BankGuardActivity -->
                    <include
                        android:id="@+id/rowBankGuard"
                        layout="@layout/inc_settings_chevron_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <!-- Ruxsatlar X-nuri (ortiqcha ruxsat so'ragan ilovalar) → PermissionXrayActivity -->
                    <include
                        android:id="@+id/rowPermXray"
                        layout="@layout/inc_settings_chevron_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <!-- Haftalik hisobot toggle (Config.isWeeklyReportEnabled) -->
                    <include
                        android:id="@+id/rowWeeklyReport"
                        layout="@layout/inc_settings_toggle_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <!-- DNS C2-filtri toggle (Config.isVpnFilterEnabled → VpnFilterService) -->
                    <include
                        android:id="@+id/rowVpnFilter"
                        layout="@layout/inc_settings_toggle_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <!-- Havola qalqoni toggle (Config.isLinkGuardEnabled → LinkGuardActivity) -->
                    <include
                        android:id="@+id/rowLinkGuard"
                        layout="@layout/inc_settings_toggle_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <!-- Ishonchli ro'yxat (UserWhitelist) — ko'rish/olib tashlash dialogi -->
                    <include
                        android:id="@+id/rowTrustList"
                        layout="@layout/inc_settings_chevron_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <include
                        android:id="@+id/rowPrivacy"
                        layout="@layout/inc_settings_chevron_row" />

                    <View
                        android:id="@+id/divAdminPanel"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/kq_hairline" />

                    <include
                        android:id="@+id/rowAdminPanel"
                        layout="@layout/inc_settings_chevron_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════ MAXFIYLIK (rozilik) ════ -->
            <TextView
                style="@style/KQ4.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="9dp"
                android:text="@string/set_privacy_eyebrow" />

            <com.google.android.material.card.MaterialCardView
                style="@style/KQ4.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvConsentTimestamp"
                        style="@style/KQ4.RowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/kq_ink_2" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/KQ4.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/set_community_label" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swCommunityShare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:thumb="@drawable/kq4_toggle_thumb"
                            app:track="@drawable/kq4_toggle_track" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/kq_hairline" />

                    <TextView
                        android:id="@+id/btnRevokeConsent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/onest_semibold"
                        android:paddingVertical="4dp"
                        android:text="@string/set_revoke_consent"
                        android:textColor="@color/kq_danger"
                        android:textSize="14.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Futer ── -->
            <TextView
                android:id="@+id/tvSettingsFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/ssmono_medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:lineSpacingMultiplier="1.7"
                android:textColor="@color/kq_ink_3"
                android:textSize="10.5sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Umumiy pastki navigatsiya: KqBottomNav.attach(this, SETTINGS). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <include layout="@layout/view_kq_bottom_nav" />
    </FrameLayout>
</FrameLayout>
