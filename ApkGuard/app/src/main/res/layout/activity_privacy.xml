<?xml version="1.0" encoding="utf-8"?>
<!--
  Maxfiylik siyosati — v4 «Milliy Kiber Himoya» dizayni.
  Layout hozircha hech bir Activity tomonidan ishlatilmaydi (orphan);
  barqaror id'lar saqlangan: btnBack, btnAccept, sec1..sec8.
  Bo'limlar inc_doc_section orqali Kotlin'dan to'ldiriladi (agar ulansa).
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <!-- Sarlavha qatori -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/kq4_icon_btn"
                android:contentDescription="@string/kq4_back"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic4_back"
                app:tint="@color/kq_ink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/KQ4.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kq4_misc_doc_eyebrow" />

                <TextView
                    style="@style/KQ4.HTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/privacy_title"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Brand header card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/KQ4.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/kq4_av_primary">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic4_lock"
                        app:tint="@color/kq_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/onest_bold"
                        android:letterSpacing="-0.01"
                        android:text="@string/privacy_title"
                        android:textColor="@color/kq_ink"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/KQ4.Mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/terms_last_update"
                        android:textAllCaps="true"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Intro -->
        <TextView
            style="@style/KQ4.HSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/kq4_misc_privacy_intro"
            android:textSize="14.5sp" />

        <include
            layout="@layout/inc_doc_section"
            android:id="@+id/sec1" />
        <include
            layout="@layout/inc_doc_section"
            android:id="@+id/sec2" />
        <include
            layout="@layout/inc_doc_section"
            android:id="@+id/sec3" />
        <include
            layout="@layout/inc_doc_section"
            android:id="@+id/sec4" />
        <include
            layout="@layout/inc_doc_section"
            android:id="@+id/sec5" />
        <include
            layout="@layout/inc_doc_section"
            android:id="@+id/sec6" />
        <include
            layout="@layout/inc_doc_section"
            android:id="@+id/sec7" />
        <include
            layout="@layout/inc_doc_section"
            android:id="@+id/sec8" />

        <!-- CTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccept"
            style="@style/KQ4.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:minHeight="58dp"
            android:text="@string/btn_understand"
            android:textSize="17sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
