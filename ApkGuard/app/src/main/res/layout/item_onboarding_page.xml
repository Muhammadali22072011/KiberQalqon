<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 Onboarding bitta slayd (design_v4_extracted/screens1.jsx → Onboarding):
    - markazda 176dp doira: tashqi — kq4_circle_primary_soft, ichki (inset 28dp) —
      kq4_circle_surface, o'rtada slayd ikonkasi 62dp, tint kq_primary
    - orqada dekorativ 8 qirrali yulduzlar (kq4_star, past alpha)
    - pastda: eyebrow "1 · 3" + h-title + h-sub (minHeight 90dp)
  Nuqta-progress va tugma activity_onboarding.xml'da (slayd bilan birga surilmaydi).
  ID'lar: ivSlideIcon, tvEyebrow, tvTitle, tvDesc.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- VIZUAL — yulduz ornament + 176dp doira markazda -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ornament: tarqoq yulduzlar, juda past alpha (design ornament o'zgaruvchisi) -->
        <ImageView
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="26dp"
            android:layout_marginTop="34dp"
            android:alpha="0.07"
            android:contentDescription="@null"
            android:src="@drawable/kq4_star" />

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="84dp"
            android:layout_marginEnd="34dp"
            android:alpha="0.07"
            android:contentDescription="@null"
            android:src="@drawable/kq4_star" />

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="52dp"
            android:layout_marginBottom="30dp"
            android:alpha="0.07"
            android:contentDescription="@null"
            android:src="@drawable/kq4_star" />

        <!-- 176dp doira: primary-soft → surface (inset 28dp) → ikonka 62dp -->
        <FrameLayout
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:layout_gravity="center">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/kq4_circle_primary_soft" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="28dp"
                android:background="@drawable/kq4_circle_surface"
                android:elevation="2dp" />

            <ImageView
                android:id="@+id/ivSlideIcon"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:elevation="3dp"
                app:tint="@color/kq_primary"
                tools:src="@drawable/ic4_scan" />
        </FrameLayout>
    </FrameLayout>

    <!-- MATN BLOKI — screen-pad (18dp yon) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp">

        <TextView
            android:id="@+id/tvEyebrow"
            style="@style/KQ4.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="1 · 3" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/KQ4.HTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            tools:text="Telefoningizni o\'zi tekshiradi" />

        <TextView
            android:id="@+id/tvDesc"
            style="@style/KQ4.HSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="90dp"
            tools:text="Anor Qalqon Telegram, WhatsApp va yuklab olingan fayllarni o\'zi kuzatib turadi." />
    </LinearLayout>
</LinearLayout>
