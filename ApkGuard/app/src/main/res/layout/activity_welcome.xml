<?xml version="1.0" encoding="utf-8"?>
<!--
  Welcome ekrani — v4 «Milliy Kiber Himoya» dizayni.
  Layout hozircha hech bir Activity tomonidan ishlatilmaydi (orphan), shuning
  uchun barcha eski id'lar saqlangan: badgeUz, imgLogoFrame, imgLogo, tvAppName,
  divLine, tvTagline, cardForm, etFirstName, etLastName, checkboxAgree,
  tvTerms, tvPrivacy, btnContinue, tvAbout.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <!-- Milliy badge (tag outline) -->
        <LinearLayout
            android:id="@+id/badgeUz"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/kq4_tag_outline"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:contentDescription="@null"
                android:src="@drawable/kq4_dot"
                app:tint="@color/kq_primary" />

            <TextView
                style="@style/KQ4.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/kq4_milliy"
                android:textAllCaps="true"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Logo disk -->
        <FrameLayout
            android:id="@+id/imgLogoFrame"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/kq4_circle_white"
            android:elevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/badgeUz">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/kq_logo_anor" />
        </FrameLayout>

        <!-- Nomi -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/onest_extrabold"
            android:letterSpacing="-0.02"
            android:text="@string/kq4_brand"
            android:textAllCaps="true"
            android:textColor="@color/kq_ink"
            android:textSize="28sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogoFrame" />

        <View
            android:id="@+id/divLine"
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:background="@color/kq_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAppName" />

        <TextView
            android:id="@+id/tvTagline"
            style="@style/KQ4.HSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/kq4_misc_welcome_tagline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divLine" />

        <!-- Forma kartasi -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardForm"
            style="@style/KQ4.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/tvTagline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/KQ4.SecTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kq4_misc_welcome_title" />

                <TextView
                    style="@style/KQ4.RowSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/kq4_misc_welcome_sub" />

                <!-- Ism -->
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/kq4_input"
                    android:fontFamily="@font/onest_regular"
                    android:hint="@string/kq4_misc_welcome_first_name"
                    android:inputType="textPersonName|textCapWords"
                    android:minHeight="54dp"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/kq_ink"
                    android:textColorHint="@color/kq_ink_3"
                    android:textSize="15sp" />

                <!-- Familiya -->
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/kq4_input"
                    android:fontFamily="@font/onest_regular"
                    android:hint="@string/kq4_misc_welcome_last_name"
                    android:inputType="textPersonName|textCapWords"
                    android:minHeight="54dp"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/kq_ink"
                    android:textColorHint="@color/kq_ink_3"
                    android:textSize="15sp" />

                <!-- Rozilik -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkboxAgree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:buttonTint="@color/kq_primary"
                    android:fontFamily="@font/onest_regular"
                    android:text="@string/kq4_misc_welcome_agree"
                    android:textColor="@color/kq_ink_2"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTerms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/onest_semibold"
                        android:padding="6dp"
                        android:text="@string/terms_title"
                        android:textColor="@color/kq_primary"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/kq4_dot"
                        app:tint="@color/kq_ink_3" />

                    <TextView
                        android:id="@+id/tvPrivacy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/onest_semibold"
                        android:padding="6dp"
                        android:text="@string/privacy_title"
                        android:textColor="@color/kq_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- CTA -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContinue"
                    style="@style/KQ4.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:enabled="false"
                    android:minHeight="58dp"
                    android:text="@string/kq4_continue"
                    android:textSize="17sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Podval -->
        <TextView
            android:id="@+id/tvAbout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/onest_semibold"
            android:padding="10dp"
            android:text="@string/kq4_misc_welcome_about"
            android:textColor="@color/kq_primary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardForm" />

        <TextView
            style="@style/KQ4.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/kq4_misc_welcome_footer"
            android:textSize="10.5sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAbout" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
