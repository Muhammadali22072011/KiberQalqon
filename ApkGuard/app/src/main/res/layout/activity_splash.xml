<?xml version="1.0" encoding="utf-8"?>
<!--
  KiberQalqon splash. Mirrors Splash in screens-onboarding.jsx:
    1. turquoise to darker-turquoise gradient (kq_primary_light to kq_primary_2_light)
    2. tiled 8-point Uzbek star pattern on top (white at ~18 percent)
    3. centered halo with 2 pulsing rings plus the shield mark
    4. "KiberQalqon" wordmark (mixed case)
    5. mono eyebrow "TELEFON HIMOYASI · V {versionName}"
    6. tagline "Zararli APK fayllardan himoyalanish"
    7. three pulsing load dots near the bottom
  IDs kept stable so SplashActivity.kt keeps working unchanged:
    ivLogo, tvAppName, tvSubtitle, tvVersion
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kq_splash_gradient">

    <!-- subtle tiled star pattern on top of the gradient. Uses a single vector
         drawable with a 4x7 grid of stars baked in (BitmapDrawable + vector src
         crashes on API 28). Stretched to fill: aspect-ratio drift is acceptable
         for a low-alpha ornament. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/kq_star_tile_white" />

    <!-- vertical column: shield · wordmark · eyebrow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <!-- 160dp hero: 2 pulsing rings + halo + shield -->
        <FrameLayout
            android:id="@+id/heroBox"
            android:layout_width="160dp"
            android:layout_height="160dp">

            <View
                android:id="@+id/pulseRing1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/kq_pulse_ring" />

            <View
                android:id="@+id/pulseRing2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/kq_pulse_ring" />

            <View
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:background="@drawable/kq_shield_halo" />

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:contentDescription="@string/app_name"
                android:src="@drawable/kq_shield_mark_white" />
        </FrameLayout>

        <!-- wordmark — "KiberQalqon" (mixed case per design, 38sp / 800) -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:alpha="0"
            android:letterSpacing="-0.02"
            android:text="@string/dash_brand"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold" />

        <!-- mono eyebrow — "TELEFON HIMOYASI · V {versionName}". -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.85"
            android:fontFamily="monospace"
            android:letterSpacing="0.24"
            android:text="TELEFON HIMOYASI · V 7.5"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="normal" />
    </LinearLayout>

    <!-- tagline near the bottom -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="70dp"
        android:alpha="0.75"
        android:text="@string/splash_subtitle2"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <!-- three load dots, staggered animation -->
    <LinearLayout
        android:id="@+id/loadDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="38dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/loadDot1"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/kq_load_dot" />

        <View
            android:id="@+id/loadDot2"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/kq_load_dot" />

        <View
            android:id="@+id/loadDot3"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/kq_load_dot" />
    </LinearLayout>

    <!-- Hidden but kept so SplashActivity's long-press diagnostics hook still works. -->
    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:alpha="0"
        android:text="VERSION 7.5"
        android:textColor="#FFFFFF"
        android:textSize="10sp" />
</FrameLayout>
