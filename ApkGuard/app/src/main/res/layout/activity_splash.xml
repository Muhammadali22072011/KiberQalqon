<?xml version="1.0" encoding="utf-8"?>
<!--
  UZGUARD splash — v4 «Milliy Kiber Himoya» dizayni (screens1.jsx → Splash):
    · to'liq ekran anor-gradient fon (@drawable/kq4_splashlanguage_bg — kq4_splash_bg'dagi
      noqonuniy angle=255 [45 ga karrali emas → inflate'da XmlPullParserException] tufayli
      guruhning o'z drawable'i bilan almashtirildi, angle=270)
    · 3 ta dekorativ 8 qirrali yulduz (oq tint, alpha ~0.12)
    · markazda LogoDisc: oq doira 116dp + haqiqiy anor-qalqon logotipi (~96dp)
    · LogoDisc atrofida 2 ta pulsar halqa (scale+alpha, ikkinchisi +800ms)
    · "UZGUARD" 34sp ExtraBold, ls -0.03 · mono "MILLIY KIBER HIMOYA" 12sp ls 0.22
    · pastda 3 ta oq load-nuqta (stagger)
  Barqaror ID'lar saqlangan (SplashActivity ularga bog'liq):
    splashRoot, starsBox, contentColumn, heroBox, pulseRing1/2, logoDisc, ivLogo,
    tvAppName, tvSubtitle, loadDots, loadDot1-3, tvVersion (yashirin, long-press diag).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kq4_splashlanguage_bg"
    android:clipChildren="false">

    <!-- dekorativ yulduzlar (dizayn: STAR_TILE, oq, alpha .12) -->
    <FrameLayout
        android:id="@+id/starsBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-16dp"
            android:layout_marginTop="72dp"
            android:alpha="0.12"
            android:contentDescription="@null"
            android:src="@drawable/kq4_star"
            app:tint="#FFFFFF" />

        <ImageView
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="150dp"
            android:layout_marginEnd="26dp"
            android:alpha="0.12"
            android:contentDescription="@null"
            android:src="@drawable/kq4_star"
            app:tint="#FFFFFF" />

        <ImageView
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="150dp"
            android:alpha="0.12"
            android:contentDescription="@null"
            android:src="@drawable/kq4_star"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <!-- markaziy kolonna: LogoDisc + wordmark + mono tagline -->
    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <!-- 170dp hero: 2 pulsar halqa + LogoDisc (dizayn: width/height 170) -->
        <FrameLayout
            android:id="@+id/heroBox"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:clipChildren="false">

            <View
                android:id="@+id/pulseRing1"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:background="@drawable/kq_pulse_ring" />

            <View
                android:id="@+id/pulseRing2"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:background="@drawable/kq_pulse_ring" />

            <!-- LogoDisc 116dp: oq doira + anor-qalqon PNG (116×0.84 ≈ 96dp) -->
            <FrameLayout
                android:id="@+id/logoDisc"
                android:layout_width="116dp"
                android:layout_height="116dp"
                android:layout_gravity="center"
                android:background="@drawable/kq4_circle_white">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/kq_logo_anor" />
            </FrameLayout>
        </FrameLayout>

        <!-- wordmark: 800 34px, ls -.03em (dizayn marginTop 32) -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:alpha="0"
            android:fontFamily="@font/onest_extrabold"
            android:letterSpacing="-0.03"
            android:text="@string/splash_logo_title"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <!-- mono tagline: 12px, ls .22em, oq 90% (long-press → diagnostika) -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0"
            android:fontFamily="@font/ssmono_semibold"
            android:letterSpacing="0.22"
            android:text="@string/kq4_milliy"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 3 ta load-nuqta (dizayn: bottom 54, 9px, gap 8) -->
    <LinearLayout
        android:id="@+id/loadDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="54dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/loadDot1"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/kq4_dot" />

        <View
            android:id="@+id/loadDot2"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/kq4_dot" />

        <View
            android:id="@+id/loadDot3"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/kq4_dot" />
    </LinearLayout>

    <!-- Yashirin, lekin saqlangan — long-press diagnostika kirishi shu yerga bog'liq. -->
    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:alpha="0"
        android:textColor="#FFFFFF"
        android:textSize="10sp" />
</FrameLayout>
