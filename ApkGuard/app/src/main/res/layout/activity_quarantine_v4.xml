<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 Karantin ekrani (design screens2.jsx → Quarantine).
  Tarkib: icon-btn back + eyebrow/h-title, h-sub, bo'sh holat kartasi yoki
  fayllar ro'yxati kartasi (qatorlar item_kq4_quarantine_entry.xml dan
  dinamik qo'shiladi) + pastda "Karantinni butunlay tozalash" ghost tugma.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <!-- .screen-pad: 14 / 18 / 30 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <!-- header row: icon-btn back + eyebrow + h-title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnQuarBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/kq4_icon_btn"
                android:contentDescription="@string/kq4_back"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic4_back"
                app:tint="@color/kq_ink_2" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/KQ4.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kq4_quar_eyebrow" />

                <TextView
                    style="@style/KQ4.HTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/kq4_quar_title"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/KQ4.HSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/kq4_quar_sub" />

        <!-- bo'sh holat: card padding 36, markazda -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuarEmpty"
            style="@style/KQ4.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="36dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/kq4_quar_empty_title"
                    android:src="@drawable/ic4_check_circle"
                    app:tint="@color/kq_safe" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/onest_semibold"
                    android:text="@string/kq4_quar_empty_title"
                    android:textColor="@color/kq_ink"
                    android:textSize="15sp" />

                <TextView
                    style="@style/KQ4.HSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/kq4_quar_empty_sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ro'yxat kartasi: qatorlar Kotlin'dan qo'shiladi -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuarList"
            style="@style/KQ4.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/quarList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuarClearAll"
            style="@style/KQ4.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/kq4_quar_clear_all"
            android:visibility="gone"
            app:icon="@drawable/ic4_trash"
            app:iconSize="19dp" />
    </LinearLayout>
</ScrollView>
