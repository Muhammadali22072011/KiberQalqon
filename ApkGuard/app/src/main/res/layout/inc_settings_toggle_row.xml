<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 Settings toggle row (dizayn .li): 44dp av (kq4_av_primary) + ic4_* ikon +
  KQ4.RowTitle/RowSub + 50×30 toggle (kq4_toggle_track/thumb).
  Stable id'lar: ivRowIcon, tvRowTitle, tvRowSub, swRow.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="15dp"
    android:paddingVertical="14dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/kq4_av_primary">

        <ImageView
            android:id="@+id/ivRowIcon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic4_scan"
            app:tint="@color/kq_primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowTitle"
            style="@style/KQ4.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/kq4_set_row_autoscan_title" />

        <TextView
            android:id="@+id/tvRowSub"
            style="@style/KQ4.RowSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/kq4_set_row_autoscan_sub" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/swRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:thumb="@drawable/kq4_toggle_thumb"
        app:track="@drawable/kq4_toggle_track" />
</LinearLayout>
