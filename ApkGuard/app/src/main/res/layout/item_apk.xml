<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 «Milliy Kiber Himoya» — Skaner ro'yxati qatori (design .li, screens1.jsx Apps).
  av 48dp (safe/danger/warn/neutral — kod tanlaydi) + RowTitle fayl nomi +
  RowSub "{manba} · {hajm}" + o'ngda tag (dot + matn). Pastda 1dp hairline ajratgich.
  ID kontrakt (ApkAdapter): avBox, avIcon, tvName, tvSub, tagBox, tagDot, tagText, rowDivider.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="15dp"
        android:paddingVertical="14dp">

        <!-- .av 48dp r18 — fon/ikonka verdiktga qarab kodda almashtiriladi -->
        <FrameLayout
            android:id="@+id/avBox"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/kq4_av_neutral">

            <ImageView
                android:id="@+id/avIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic4_file"
                app:tint="@color/kq_ink_2" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                style="@style/KQ4.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="example.apk" />

            <TextView
                android:id="@+id/tvSub"
                style="@style/KQ4.RowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Telegram · 1.6 MB" />
        </LinearLayout>

        <!-- .tag h30 — dot + matn, rang/fon verdiktga qarab kodda -->
        <LinearLayout
            android:id="@+id/tagBox"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/kq4_tag_soft"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/tagDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:contentDescription="@null"
                android:src="@drawable/kq4_dot"
                app:tint="@color/kq_ink_2" />

            <TextView
                android:id="@+id/tagText"
                style="@style/KQ4.Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/kq4_skaner_tag_unknown"
                android:textColor="@color/kq_ink_2" />
        </LinearLayout>
    </LinearLayout>

    <!-- design .li border-bottom (oxirgi qatorda adapter yashiradi) -->
    <View
        android:id="@+id/rowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/kq_hairline" />
</LinearLayout>
