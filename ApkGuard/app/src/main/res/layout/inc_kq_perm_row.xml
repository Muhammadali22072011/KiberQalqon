<?xml version="1.0" encoding="utf-8"?>
<!--
  Bitta xavfli ruxsat satri (ScanResultActivity dinamik to'ldiradi):
    rang nuqtasi (xavf darajasi) · nom (oddiy til) + xom nom · daraja yorlig'i.
  IDlar: vPermDot, tvPermLabel, tvPermRaw, tvPermSev.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:id="@+id/vPermDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/kq_safe_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPermLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Mikrofon"
            android:textColor="@color/kq_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPermRaw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="RECORD_AUDIO"
            android:textColor="@color/kq_ink_3"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPermSev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/kq_sev_crit"
        android:fontFamily="monospace"
        android:letterSpacing="0.06"
        android:paddingHorizontal="9dp"
        android:paddingVertical="5dp"
        android:text="@string/perm_sev_critical"
        android:textColor="@color/kq_danger_ink"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
