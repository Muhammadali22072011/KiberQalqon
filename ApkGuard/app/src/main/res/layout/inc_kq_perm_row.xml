<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 «.li» ro'yxat satri — ScanResult ("Bu fayl nima qiladi?") va
  PermissionsDetail (ruxsat guruhlari) dinamik to'ldiradi.
  Kvadrat .av 44dp (fonni kod beradi: kq4_av_danger/warn/neutral/safe) +
  ikonka (tint kodda) + sarlavha (wrap) + ixtiyoriy izoh (default gone).
  IDlar: permAv, permIcon, tvPermLabel, tvPermSub, permDivider.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="15dp"
        android:paddingVertical="14dp">

        <FrameLayout
            android:id="@+id/permAv"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/kq4_av_danger">

            <ImageView
                android:id="@+id/permIcon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic4_lock"
                app:tint="@color/kq_danger" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPermLabel"
                style="@style/KQ4.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvPermSub"
                style="@style/KQ4.RowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/permDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/kq_hairline" />
</LinearLayout>
