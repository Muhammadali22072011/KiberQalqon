<?xml version="1.0" encoding="utf-8"?>
<!--
  APK ro'yxati — v4 «Milliy Kiber Himoya» dizayni (Apps/Skaner pattern).
  Layout hozircha hech bir Activity tomonidan ishlatilmaydi (orphan);
  barqaror id'lar saqlangan: btnBack, btnSearch, chipGroup, chipAll,
  chipDangerous, chipSuspicious, chipSafe, txtStatTotal, txtStatDanger,
  txtStatSuspicious, txtStatSafe, recyclerView, layoutEmpty, fabScanAll.
  Ro'yxat qatori item_apk.xml (boshqa agentniki) — o'zgartirilmagan.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="30dp">

            <!-- Sarlavha qatori: back + eyebrow/title/sub + search icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/kq4_icon_btn"
                    android:contentDescription="@string/kq4_back"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic4_back"
                    app:tint="@color/kq_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/KQ4.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kq4_misc_eyebrow_scanner" />

                    <TextView
                        style="@style/KQ4.HTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/apk_list_title"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/txtStatTotal"
                        style="@style/KQ4.RowSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/kq4_misc_apk_list_sub" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSearch"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/kq4_icon_btn"
                    android:contentDescription="@string/kq4_misc_eyebrow_scanner"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic4_search"
                    app:tint="@color/kq_ink_2" />
            </LinearLayout>

            <!-- Filtr chiplari (gorizontal aylanadigan) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacing="8dp"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:fontFamily="@font/onest_semibold"
                        android:text="@string/filter_all_count"
                        android:textColor="@color/kq_on_primary"
                        android:textSize="14.5sp"
                        app:chipBackgroundColor="@color/kq_primary"
                        app:chipCornerRadius="21dp"
                        app:chipMinHeight="42dp"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDangerous"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/onest_semibold"
                        android:text="@string/filter_dangerous_count"
                        android:textColor="@color/kq_ink_2"
                        android:textSize="14.5sp"
                        app:chipBackgroundColor="@android:color/transparent"
                        app:chipCornerRadius="21dp"
                        app:chipMinHeight="42dp"
                        app:chipStrokeColor="@color/kq_hairline_strong"
                        app:chipStrokeWidth="1.5dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSafe"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/onest_semibold"
                        android:text="@string/filter_safe_count"
                        android:textColor="@color/kq_ink_2"
                        android:textSize="14.5sp"
                        app:chipBackgroundColor="@android:color/transparent"
                        app:chipCornerRadius="21dp"
                        app:chipMinHeight="42dp"
                        app:chipStrokeColor="@color/kq_hairline_strong"
                        app:chipStrokeWidth="1.5dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSuspicious"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/onest_semibold"
                        android:text="@string/filter_suspicious"
                        android:textColor="@color/kq_ink_2"
                        android:textSize="14.5sp"
                        android:visibility="gone"
                        app:chipBackgroundColor="@android:color/transparent"
                        app:chipCornerRadius="21dp"
                        app:chipMinHeight="42dp"
                        app:chipStrokeColor="@color/kq_hairline_strong"
                        app:chipStrokeWidth="1.5dp" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Yashirin compat statlar (eski binding murojaatlari uchun) -->
            <TextView
                android:id="@+id/txtStatDanger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
            <TextView
                android:id="@+id/txtStatSuspicious"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
            <TextView
                android:id="@+id/txtStatSafe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Ro'yxat kartasi — bitta KQ4.Card, ichida recycler -->
            <com.google.android.material.card.MaterialCardView
                style="@style/KQ4.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Bo'sh holat -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/kq4_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="36dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic4_folder"
                    app:tint="@color/kq_ink_3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/onest_semibold"
                    android:text="@string/empty_apk_list"
                    android:textColor="@color/kq_ink"
                    android:textSize="15sp" />

                <TextView
                    style="@style/KQ4.HSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/empty_apk_desc"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- Pastki CTA — "Hammasi qayta tekshirilsin" -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/fabScanAll"
                style="@style/KQ4.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/apk_list_rescan"
                app:icon="@drawable/ic4_refresh"
                app:iconSize="19dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
