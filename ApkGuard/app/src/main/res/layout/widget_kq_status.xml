<?xml version="1.0" encoding="utf-8"?>
<!--
  UzGuard home screen widget — 4x2 holat kartochkasi.

  Chap tomonda qalqon ikonkasi + tahdid statusi nuqtasi.
  O'rtada — "Himoyalangan" / "Tahdid topildi" sarlavhasi + oxirgi skan vaqti.
  O'ng tomonda — "Skan" dumaloq tugmasi (MainActivity'ni ochadi).

  Foydalanuvchi widget ustiga bossa — Dashboard ochiladi.
  "Skan" tugmasiga bossa — MainActivity (tezkor skan) ochiladi.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kq_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Qalqon ikonkasi + status nuqtasi (ikonkaning past-o'ngida). -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/widgetShield"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_shield_check" />

        <View
            android:id="@+id/widgetStatusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="end|bottom"
            android:background="@drawable/kq_widget_dot_safe" />
    </FrameLayout>

    <!-- Matn ustuni -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/dash_brand"
            android:textColor="@color/kq_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/status_protected"
            android:textColor="@color/kq_ink_2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widgetLastScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="Oxirgi skan: —"
            android:textColor="@color/kq_ink_3"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Skan tugmasi -->
    <TextView
        android:id="@+id/widgetScanBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/kq_widget_scan_btn"
        android:minWidth="80dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:gravity="center"
        android:text="@string/widget_scan_btn"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
