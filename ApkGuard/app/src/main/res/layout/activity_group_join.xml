<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 dizayn «Guruhga qo'shilish». Foydalanuvchi kod kiritadi yoki QR skanerlaydi, so'ng
  ism/familiya/telefonini yozadi va guruhga qo'shiladi. GroupJoinActivity.kt IDlari:
  btnBack, cardCurrent, dotCurrent, tvCurrent, etCode, btnScan, etFirst, etLast, etPhone,
  tvPrivacy, btnJoin, tvStatus.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <!-- ═══ Sarlavha ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/kq4_icon_btn"
                android:contentDescription="@string/kq4_back"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic4_back"
                app:tint="@color/kq_ink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/KQ4.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kq4_group_eyebrow" />

                <TextView
                    style="@style/KQ4.HTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/kq4_group_title"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Joriy guruh (allaqachon qo'shilgan bo'lsa) ═══ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCurrent"
            style="@style/KQ4.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <View
                    android:id="@+id/dotCurrent"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/kq4_av_primary" />

                <TextView
                    android:id="@+id/tvCurrent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/onest_bold"
                    android:text="@string/kq4_group_current"
                    android:textColor="@color/kq_ink"
                    android:textSize="14.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══ Kod / QR ═══ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/KQ4.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/KQ4.SecTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/kq4_group_code_label"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:background="@drawable/kq4_input"
                        android:fontFamily="@font/ssmono_medium"
                        android:hint="@string/kq4_group_code_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:letterSpacing="0.1"
                        android:maxLength="16"
                        android:minHeight="52dp"
                        android:padding="14dp"
                        android:textColor="@color/kq_ink"
                        android:textColorHint="@color/kq_ink_3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScan"
                        style="@style/KQ4.Button.Soft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="10dp"
                        android:minHeight="52dp"
                        android:text="@string/kq4_group_scan"
                        app:icon="@drawable/ic4_qr"
                        app:iconSize="18dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══ Ma'lumotlaringiz ═══ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/KQ4.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/KQ4.SecTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/kq4_group_you_label"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etFirst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/kq4_input"
                    android:fontFamily="@font/onest_regular"
                    android:hint="@string/kq4_group_first_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="40"
                    android:minHeight="52dp"
                    android:padding="14dp"
                    android:textColor="@color/kq_ink"
                    android:textColorHint="@color/kq_ink_3" />

                <EditText
                    android:id="@+id/etLast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/kq4_input"
                    android:fontFamily="@font/onest_regular"
                    android:hint="@string/kq4_group_last_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="40"
                    android:minHeight="52dp"
                    android:padding="14dp"
                    android:textColor="@color/kq_ink"
                    android:textColorHint="@color/kq_ink_3" />

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/kq4_input"
                    android:fontFamily="@font/ssmono_medium"
                    android:hint="@string/kq4_group_phone_hint"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLength="20"
                    android:minHeight="52dp"
                    android:padding="14dp"
                    android:textColor="@color/kq_ink"
                    android:textColorHint="@color/kq_ink_3" />

                <TextView
                    android:id="@+id/tvPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/onest_regular"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/kq4_group_privacy"
                    android:textColor="@color/kq_ink_3"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJoin"
            style="@style/KQ4.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="54dp"
            android:text="@string/kq4_group_join_btn"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/onest_medium"
            android:gravity="center"
            android:text=""
            android:textColor="@color/kq_ink_2"
            android:textSize="13.5sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
