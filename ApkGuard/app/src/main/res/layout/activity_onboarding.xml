<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 «Milliy Kiber Himoya» Onboarding qobig'i (design_v4_extracted/screens1.jsx → Onboarding):
    - yuqori o'ngda "O'tkazib yuborish" (600 14sp, kq_ink_3)
    - ViewPager2 — 3 slayd (doira-ikonka + eyebrow + sarlavha + matn, item_onboarding_page.xml)
    - nuqta-progress (faol — 26x8dp pilyulya kq_primary, qolganlari 8dp doira kq_hairline_strong)
    - to'liq enli KQ4.Button.Primary lg (h58): "Davom etish" / oxirgisida "Himoyani yoqish"
  ID'lar barqaror: viewPager, layoutIndicator, btnSkip, btnNext.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg">

    <!-- skip — yuqori o'ng (design: padding 10px 16px, 600 14px, ink-3) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSkip"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/onest_semibold"
        android:letterSpacing="0"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="12dp"
        android:text="@string/btn_skip"
        android:textAllCaps="false"
        android:textColor="@color/kq_ink_3"
        android:textSize="14sp"
        app:rippleColor="@color/kq_surface_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3 slayd: doira-vizual + matn bloki har bir sahifada -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layoutIndicator"
        app:layout_constraintTop_toBottomOf="@id/btnSkip" />

    <!-- nuqta-progress (design: gap 7, margin 16px 0 18px) -->
    <LinearLayout
        android:id="@+id/layoutIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- btn primary block lg (h58, 17sp) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        style="@style/KQ4.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginBottom="26dp"
        android:minHeight="58dp"
        android:text="@string/kq4_continue"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
