<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 Himoya holati ekrani (design screens2.jsx → Protection).
  Tarkib: icon-btn back + eyebrow/h-title, markazda halqa (KqRingView 120,
  ichida qalqon ikonkasi) bilan hero-karta (yulduz ornament alpha .05),
  ruxsatlar ro'yxati kartasi (qatorlar item_kq4_protection_row.xml dan
  dinamik) + pastda "Davom etish" (asl onboarding-gate logikasi saqlangan).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <!-- .screen-pad: 14 / 18 / 30 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <!-- header row: icon-btn back + eyebrow + h-title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnProtBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/kq4_icon_btn"
                android:contentDescription="@string/kq4_back"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic4_back"
                app:tint="@color/kq_ink_2" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/KQ4.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kq4_prot_eyebrow" />

                <TextView
                    style="@style/KQ4.HTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/kq4_prot_title"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- hero card: halqa + hisob + izoh, fonda yulduz ornament -->
        <com.google.android.material.card.MaterialCardView
            style="@style/KQ4.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- .pattern: 8 qirrali yulduzlar, alpha .05 -->
                <ImageView
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="8dp"
                    android:alpha="0.05"
                    android:importantForAccessibility="no"
                    android:src="@drawable/kq4_star" />

                <ImageView
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="42dp"
                    android:layout_marginEnd="14dp"
                    android:alpha="0.05"
                    android:importantForAccessibility="no"
                    android:src="@drawable/kq4_star" />

                <ImageView
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="64dp"
                    android:layout_marginBottom="6dp"
                    android:alpha="0.05"
                    android:importantForAccessibility="no"
                    android:src="@drawable/kq4_star" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp">

                        <com.kiberqalqon.KqRingView
                            android:id="@+id/ringProt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <ImageView
                            android:id="@+id/imgProtShield"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/kq4_prot_eyebrow"
                            android:src="@drawable/ic4_shield_check"
                            app:tint="@color/kq_safe" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvProtCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/onest_bold"
                        android:textColor="@color/kq_ink"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvProtHint"
                        style="@style/KQ4.HSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ruxsatlar ro'yxati kartasi: qatorlar Kotlin'dan qo'shiladi -->
        <com.google.android.material.card.MaterialCardView
            style="@style/KQ4.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/protList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <!-- asl funksiya: onboarding-gate "Davom etish" (lg) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProtContinue"
            style="@style/KQ4.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="58dp"
            android:text="@string/kq4_continue"
            android:textSize="17sp"
            app:cornerRadius="29dp" />
    </LinearLayout>
</ScrollView>
