<?xml version="1.0" encoding="utf-8"?>
<!--
  E'lonning to'liq ko'rinishi — v4 «Milliy Kiber Himoya» dizayni.
  Lentadagi kartochka bosilganda MainActivity buni AlertDialog ichida ko'rsatadi
  (oyna foni shaffof — burchaklar yumaloq ko'rinadi):
    newsDlgImage  — to'liq rasm (havola bo'lsa ko'rinadi)
    newsDlgLevel  — daraja yorlig'i (E'lon / Ogohlantirish / Muhim) — rangi koddan
    newsDlgTitle / newsDlgDate / newsDlgBody — sarlavha, sana, matn
    newsDlgClose  — yopish (✕)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/KQ4.Card.Flat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/newsDlgImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/newsDlgLevel"
                    style="@style/KQ4.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="E'lon" />

                <TextView
                    android:id="@+id/newsDlgTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/onest_bold"
                    android:letterSpacing="-0.01"
                    android:textColor="@color/kq_ink"
                    android:textSize="18sp"
                    tools:text="Sarlavha" />

                <TextView
                    android:id="@+id/newsDlgDate"
                    style="@style/KQ4.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textSize="11sp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:maxHeight="260dp"
                    android:scrollbars="none">

                    <TextView
                        android:id="@+id/newsDlgBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/onest_regular"
                        android:lineSpacingMultiplier="1.5"
                        android:text=""
                        android:textColor="@color/kq_ink_2"
                        android:textSize="14.5sp" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/newsDlgClose"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/kq4_icon_btn"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/onest_bold"
        android:gravity="center"
        android:text="✕"
        android:textColor="@color/kq_ink"
        android:textSize="15sp" />
</FrameLayout>
