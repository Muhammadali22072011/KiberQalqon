<?xml version="1.0" encoding="utf-8"?>
<!--
  Foydalanish shartlari — v4 «Milliy Kiber Himoya» dizayni.
  Layout hozircha hech bir Activity tomonidan ishlatilmaydi (orphan);
  eski barqaror id'lar saqlangan: btnBack, btnAccept.
  Pattern: icon-btn back + eyebrow + h-title, bo'limlar = eyebrow + KQ4.Card.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <!-- Sarlavha qatori -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/kq4_icon_btn"
                android:contentDescription="@string/kq4_back"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic4_back"
                app:tint="@color/kq_ink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/KQ4.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kq4_misc_doc_eyebrow" />

                <TextView
                    style="@style/KQ4.HTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/terms_title"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/KQ4.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/terms_last_update"
            android:textAllCaps="true"
            android:textSize="10.5sp" />

        <!-- 1 · Kirish -->
        <TextView
            style="@style/KQ4.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:text="@string/kq4_misc_terms_s1" />

        <com.google.android.material.card.MaterialCardView
            style="@style/KQ4.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/onest_regular"
                android:lineSpacingMultiplier="1.5"
                android:padding="16dp"
                android:text="@string/terms_terms_body"
                android:textColor="@color/kq_ink_2"
                android:textSize="14.5sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 2 · Ilova maqsadi -->
        <TextView
            style="@style/KQ4.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:text="@string/kq4_misc_terms_s2" />

        <com.google.android.material.card.MaterialCardView
            style="@style/KQ4.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/onest_regular"
                android:lineSpacingMultiplier="1.5"
                android:padding="16dp"
                android:text="@string/kq4_misc_terms_s2_body"
                android:textColor="@color/kq_ink_2"
                android:textSize="14.5sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 3 · Foydalanuvchi majburiyatlari -->
        <TextView
            style="@style/KQ4.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:text="@string/kq4_misc_terms_s3" />

        <com.google.android.material.card.MaterialCardView
            style="@style/KQ4.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/onest_regular"
                android:lineSpacingMultiplier="1.5"
                android:padding="16dp"
                android:text="@string/kq4_misc_terms_s3_body"
                android:textColor="@color/kq_ink_2"
                android:textSize="14.5sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 4 · Cheklovlar va javobgarlik (warn card) -->
        <TextView
            style="@style/KQ4.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:text="@string/kq4_misc_terms_s4"
            android:textColor="@color/kq_danger" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/kq4_card_warn"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@null"
                android:src="@drawable/ic4_alert"
                app:tint="@color/kq_warn" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/onest_regular"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/kq4_misc_terms_s4_body"
                android:textColor="@color/kq_warn_ink"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 5 · Kerakli ruxsatlar -->
        <TextView
            style="@style/KQ4.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:text="@string/kq4_misc_terms_s5" />

        <com.google.android.material.card.MaterialCardView
            style="@style/KQ4.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/onest_regular"
                android:lineSpacingMultiplier="1.5"
                android:padding="16dp"
                android:text="@string/kq4_misc_terms_s5_body"
                android:textColor="@color/kq_ink_2"
                android:textSize="14.5sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 6 · O'zgarishlar -->
        <TextView
            style="@style/KQ4.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:text="@string/kq4_misc_terms_s6" />

        <com.google.android.material.card.MaterialCardView
            style="@style/KQ4.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/onest_regular"
                android:lineSpacingMultiplier="1.5"
                android:padding="16dp"
                android:text="@string/terms_changes_body"
                android:textColor="@color/kq_ink_2"
                android:textSize="14.5sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 7 · Aloqa -->
        <TextView
            style="@style/KQ4.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:text="@string/kq4_misc_terms_s7" />

        <com.google.android.material.card.MaterialCardView
            style="@style/KQ4.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/onest_regular"
                android:lineSpacingMultiplier="1.5"
                android:padding="16dp"
                android:text="@string/kq4_misc_terms_s7_body"
                android:textColor="@color/kq_ink_2"
                android:textSize="14.5sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- CTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccept"
            style="@style/KQ4.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:minHeight="58dp"
            android:text="@string/consent_accept"
            android:textSize="17sp"
            app:icon="@drawable/ic4_check"
            app:iconSize="19dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
