<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 «Milliy Kiber Himoya» — birinchi to'liq tekshiruv
  (design_v4_extracted/screens3.jsx → InitialScan).

  Faza A (layoutScanning): markazda KqRingView 190dp (stroke 12, rang ?attr/kqPrimary —
    kodda beriladi), ichida % 40sp onest_extrabold; pastda eyebrow "BIRINCHI TEKSHIRUV",
    h-title "Telefon tekshirilmoqda", h-sub. Real ma'lumot: joriy fayl (mono) va
    topildi/xavfli hisoblagichlar. Pastda "O'tkazib yuborish".

  Faza B (layoutResults): 80dp doira (danger-soft + ic4_shield_alert 40dp) + h-title
    "{N} ta xavfli fayl topildi" + h-sub + karta-ro'yxat (.li qatorlar kodda quriladi,
    bo'sh holatda ic4_check_circle + matn) + KQ4.Button.Danger lg "Hammasini o'chirish"
    + KQ4.Button.Primary lg "Asosiy ekranga o'tish".
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg">

    <!-- ╔════ FAZA A — SKAN ════╗ -->
    <FrameLayout
        android:id="@+id/layoutScanning"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- ornament: tarqoq yulduzlar (design starBg) -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="30dp"
            android:layout_marginTop="64dp"
            android:alpha="0.07"
            android:contentDescription="@null"
            android:src="@drawable/kq4_star" />

        <ImageView
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="140dp"
            android:layout_marginEnd="24dp"
            android:alpha="0.07"
            android:contentDescription="@null"
            android:src="@drawable/kq4_star" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Ring 190dp, stroke 12; ringColor kodda ?attr/kqPrimary'dan -->
            <FrameLayout
                android:layout_width="190dp"
                android:layout_height="190dp">

                <com.uzguard.KqRingView
                    android:id="@+id/scanRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvScanProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/onest_extrabold"
                    android:letterSpacing="-0.02"
                    android:text="0%"
                    android:textColor="@color/kq_ink"
                    android:textSize="40sp"
                    tools:ignore="HardcodedText" />
            </FrameLayout>

            <TextView
                style="@style/KQ4.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/initial_scan_eyebrow" />

            <TextView
                style="@style/KQ4.HTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/kq4_is_title" />

            <TextView
                style="@style/KQ4.HSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="300dp"
                android:text="@string/initial_scan_desc" />

            <!-- joriy tekshirilayotgan fayl (real ma'lumot) -->
            <TextView
                android:id="@+id/tvCurrentFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:ellipsize="middle"
                android:fontFamily="@font/kq4_mono"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:singleLine="true"
                android:text="—"
                android:textColor="@color/kq_ink_3"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

            <!-- hisoblagichlar: TOPILDI n · XAVFLI n -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/KQ4.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/initial_scan_found" />

                <TextView
                    android:id="@+id/tvFoundCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/ssmono_semibold"
                    android:text="0"
                    android:textColor="@color/kq_ink"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/kq4_dot"
                    android:backgroundTint="@color/kq_hairline_strong" />

                <TextView
                    style="@style/KQ4.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/initial_scan_danger"
                    android:textColor="@color/kq_danger" />

                <TextView
                    android:id="@+id/tvDangerCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/ssmono_semibold"
                    android:text="0"
                    android:textColor="@color/kq_danger"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </LinearLayout>

        <!-- Skip — skan paytida pastda -->
        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/onest_semibold"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/initial_scan_skip"
            android:textColor="@color/kq_ink_3"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- ╔════ FAZA B — NATIJA ════╗ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutResults"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="28dp"
            android:paddingBottom="30dp">

            <!-- 80dp doira + ikonka 40dp (xavfli: danger-soft, toza: safe-soft — kodda) -->
            <FrameLayout
                android:id="@+id/resultCircle"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/kq4_circle_danger_soft">

                <ImageView
                    android:id="@+id/resultIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic4_shield_alert"
                    app:tint="@color/kq_danger" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvHeaderTitle"
                style="@style/KQ4.HTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                tools:text="3 ta xavfli fayl topildi" />

            <TextView
                android:id="@+id/tvHeaderSub"
                style="@style/KQ4.HSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                tools:text="Quyidagi fayllarni o\'chirish tavsiya etiladi." />

            <!-- karta-ro'yxat: .li qatorlar kodda quriladi -->
            <com.google.android.material.card.MaterialCardView
                style="@style/KQ4.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/dangerList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- bo'sh holat: hammasi o'chirilgan / hech narsa topilmagan -->
                    <LinearLayout
                        android:id="@+id/emptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="28dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic4_check_circle"
                            app:tint="@color/kq_safe" />

                        <TextView
                            android:id="@+id/tvEmptyText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/onest_semibold"
                            android:gravity="center"
                            android:text="@string/kq4_is_all_deleted"
                            android:textColor="@color/kq_ink"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- btn danger block lg -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteAll"
                style="@style/KQ4.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="58dp"
                android:text="@string/initial_scan_delete_all"
                android:textSize="17sp"
                android:visibility="gone"
                app:icon="@drawable/ic4_trash"
                app:iconSize="20dp" />

            <!-- btn primary block lg -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                style="@style/KQ4.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="58dp"
                android:text="@string/is_go_main"
                android:textSize="17sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
