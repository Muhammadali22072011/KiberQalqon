<?xml version="1.0" encoding="utf-8"?>
<!--
  Beruvchi lentadagi (ticker) bitta e'lon kartochkasi. NewsTickerAdapter buni
  gorizontal RecyclerView ichiga inflate qiladi; lenta uzluksiz suriladi.
    newsAccent     — chap chiziq, rang darajaga qarab (info/warning/critical)
    newsThumbCard  — kichik rasm (havola bo'lsa ko'rinadi; aks holda gone)
    newsItemTitle  — sarlavha (2 qator)
    newsItemBody   — qisqa matn (bo'sh bo'lsa gone)
    newsItemDate   — sana
  Bosilsa — MainActivity to'liq e'lonni dialogda ochadi.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="264dp"
    android:layout_height="wrap_content"
    android:layout_marginVertical="2dp"
    android:layout_marginEnd="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/kq_bg_elev"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/kq_hairline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="84dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/newsAccent"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/kq_ink_3" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/newsThumbCard"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="12dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/newsItemImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/newsItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Sarlavha"
                android:textColor="@color/kq_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/newsItemBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/kq_ink_2"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/newsItemDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text=""
                android:textColor="@color/kq_ink_3"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
