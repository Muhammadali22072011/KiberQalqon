<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 «Milliy Kiber Himoya» — Skaner ekrani (screens1.jsx → Apps).

  Tuzilma (dizayn tartibida): screen-pad (14/18/30) →
    header between (eyebrow SKANER + h-title | icon-btn scan) →
    live-karta (Avto-himoya yoniq/o'chiq) → 3 filtr chip →
    loading → e'lonlar lentasi → tvCount → ro'yxat kartasi (.li qatorlar) →
    KQ4.Button.Ghost "Hammasini qayta tekshirish" → pastki navigatsiya.

  Saqlangan ID lar (MainActivity.kt binding kontrakti):
    cardPermission, btnGrant, contentMain, switchBackground (yashirin — live-karta boshqaradi),
    btnScan (endi yuqoridagi icon-btn), btnRefresh (endi pastdagi ghost tugma),
    loadingLayout, tvLoading, tvCount, recycler, layoutEmpty, newsSection, newsTicker,
    btnLang, btnDashboard, btnSettings (hidden compat).
  Yangi ID lar: cardLive, avLiveBox, avLiveIcon, tvLiveTitle, tvLiveSub,
    tagLive, tagLiveDot, tagLiveText, chipAll/Bad/Ok (+Label/+Count).
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="68dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <!-- .screen-pad: 14 / 18 / 30 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="30dp">

            <!-- ─── Header: eyebrow + h-title | icon-btn (to'liq skan) ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/KQ4.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kq4_skaner_eyebrow" />

                    <TextView
                        style="@style/KQ4.HTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/kq4_skaner_title" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnScan"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/kq4_icon_btn"
                    android:contentDescription="@string/kq4_skaner_scan_cd"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic4_scan"
                    app:tint="@color/kq_ink_2" />
            </LinearLayout>

            <!-- ─── Ruxsat kartasi (boshlang'ich holat) ─── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermission"
                style="@style/KQ4.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/kq4_av_primary">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic4_folder"
                                app:tint="?attr/kqPrimary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="13dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/onest_bold"
                            android:letterSpacing="-0.01"
                            android:text="@string/permission_required"
                            android:textColor="@color/kq_ink"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        style="@style/KQ4.RowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/permission_reason" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrant"
                        style="@style/KQ4.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/grant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── Asosiy kontent (ruxsat berilgach) ─── -->
            <FrameLayout
                android:id="@+id/contentMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ─── Live-karta: Avto-himoya holati (yoniq/o'chiq — kod boshqaradi) ─── -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardLive"
                        style="@style/KQ4.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <FrameLayout
                                android:id="@+id/avLiveBox"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/kq4_av_safe">

                                <ImageView
                                    android:id="@+id/avLiveIcon"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic4_check_circle"
                                    app:tint="@color/kq_safe" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvLiveTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/onest_bold"
                                    android:letterSpacing="-0.01"
                                    android:text="@string/kq4_skaner_live_on_title"
                                    android:textColor="@color/kq_ink"
                                    android:textSize="14.5sp" />

                                <TextView
                                    android:id="@+id/tvLiveSub"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="@font/onest_regular"
                                    android:text="@string/kq4_skaner_live_on_sub"
                                    android:textColor="@color/kq_ink_3"
                                    android:textSize="12.5sp" />
                            </LinearLayout>

                            <!-- .tag safe «Jonli» / warn «O'chiq» -->
                            <LinearLayout
                                android:id="@+id/tagLive"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/kq4_tag_safe"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp">

                                <ImageView
                                    android:id="@+id/tagLiveDot"
                                    android:layout_width="7dp"
                                    android:layout_height="7dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/kq4_dot"
                                    app:tint="@color/kq_safe_ink" />

                                <TextView
                                    android:id="@+id/tagLiveText"
                                    style="@style/KQ4.Tag"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:text="@string/kq4_live"
                                    android:textColor="@color/kq_safe_ink" />
                            </LinearLayout>

                            <!-- Yashirin tumbler — binding kontrakti uchun saqlangan; holatni
                                 live-karta bosishi va Config sinxron boshqaradi. -->
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchBackground"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ─── Filtr chiplari: Hammasi / Xavfli / Xavfsiz (+ hisoblagich) ───
                         HorizontalScrollView: uch chip + hisoblagichlar tor (360dp) ekranga
                         yoki RU tiliga sig'magan holatda o'ngdagi chip kesilib qolmasin. -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/chipAll"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:background="@drawable/kq4_skaner_chip_on"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <TextView
                                android:id="@+id/chipAllLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/onest_semibold"
                                android:letterSpacing="-0.01"
                                android:text="@string/kq4_all"
                                android:textColor="@color/kq_on_primary"
                                android:textSize="14.5sp" />

                            <TextView
                                android:id="@+id/chipAllCount"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/kq4_skaner_badge_on"
                                android:fontFamily="@font/onest_bold"
                                android:gravity="center"
                                android:minWidth="24dp"
                                android:paddingHorizontal="7dp"
                                android:text="0"
                                android:textColor="@color/kq_on_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/chipBad"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/kq4_skaner_chip_off"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <TextView
                                android:id="@+id/chipBadLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/onest_semibold"
                                android:letterSpacing="-0.01"
                                android:text="@string/kq4_danger"
                                android:textColor="@color/kq_ink_2"
                                android:textSize="14.5sp" />

                            <TextView
                                android:id="@+id/chipBadCount"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/kq4_tag_soft"
                                android:fontFamily="@font/onest_bold"
                                android:gravity="center"
                                android:minWidth="24dp"
                                android:paddingHorizontal="7dp"
                                android:text="0"
                                android:textColor="@color/kq_ink_2"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/chipOk"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/kq4_skaner_chip_off"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <TextView
                                android:id="@+id/chipOkLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/onest_semibold"
                                android:letterSpacing="-0.01"
                                android:text="@string/kq4_safe"
                                android:textColor="@color/kq_ink_2"
                                android:textSize="14.5sp" />

                            <TextView
                                android:id="@+id/chipOkCount"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/kq4_tag_soft"
                                android:fontFamily="@font/onest_bold"
                                android:gravity="center"
                                android:minWidth="24dp"
                                android:paddingHorizontal="7dp"
                                android:text="0"
                                android:textColor="@color/kq_ink_2"
                                android:textSize="12sp" />
                        </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- ─── Qidiruv indikatori ─── -->
                    <LinearLayout
                        android:id="@+id/loadingLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:indeterminateTint="?attr/kqPrimary" />

                        <TextView
                            android:id="@+id/tvLoading"
                            style="@style/KQ4.RowSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/scanner_searching"
                            android:textColor="@color/kq_ink_2" />
                    </LinearLayout>

                    <!-- ─── E'lonlar lentasi (cloud; bo'sh bo'lsa yashirin) ─── -->
                    <LinearLayout
                        android:id="@+id/newsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/KQ4.SecTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/news_section_title" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/newsTicker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never" />
                    </LinearLayout>

                    <!-- ─── Holat satri: "Topilgan APK: N" / "Tekshirilmoqda..." ─── -->
                    <TextView
                        android:id="@+id/tvCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/onest_semibold"
                        android:text="@string/scanning"
                        android:textColor="@color/kq_ink_3"
                        android:textSize="13sp" />

                    <!-- ─── Ro'yxat kartasi (.li qatorlar) + bo'sh holat ─── -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/KQ4.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="220dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <!-- Bo'sh holat — MainActivity AdapterDataObserver orqali boshqaradi -->
                            <LinearLayout
                                android:id="@+id/layoutEmpty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="32dp">

                                <FrameLayout
                                    android:layout_width="96dp"
                                    android:layout_height="96dp">

                                    <View
                                        android:layout_width="96dp"
                                        android:layout_height="96dp"
                                        android:background="@drawable/kq4_circle_safe_soft" />

                                    <ImageView
                                        android:layout_width="44dp"
                                        android:layout_height="44dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic4_shield_check"
                                        app:tint="@color/kq_safe" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:fontFamily="@font/onest_bold"
                                    android:letterSpacing="-0.01"
                                    android:text="@string/scan_empty_title"
                                    android:textColor="@color/kq_ink"
                                    android:textSize="17sp" />

                                <TextView
                                    style="@style/KQ4.RowSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:gravity="center"
                                    android:text="@string/scan_empty_desc" />
                            </LinearLayout>

                            <!-- Ro'yxat (to'lganda bo'sh holatni yopadi) -->
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recycler"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layoutAnimation="@anim/kq_layout_stagger"
                                android:nestedScrollingEnabled="false"
                                android:overScrollMode="never" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ─── Ghost tugma: hammasini qayta tekshirish ─── -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefresh"
                        style="@style/KQ4.Button.Ghost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/kq4_skaner_rescan"
                        app:icon="@drawable/ic4_refresh"
                        app:iconSize="19dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Pastki navigatsiya -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <include layout="@layout/view_kq_bottom_nav" />
    </FrameLayout>

    <!-- Compat — eski binding ID lar, yashirin -->
    <ImageButton
        android:id="@+id/btnLang"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_language"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnDashboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_threat_radar"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_settings"
        android:visibility="gone" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
