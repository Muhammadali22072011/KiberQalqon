# === local.properties Namuna ===
# Bu fayl namuna sifatida — haqiqiy local.properties ni shu modeldan yarating.
# Haqiqiy local.properties versiya control'ga tushmasligi kerak.

# Android SDK joylashuvi
sdk.dir=C\:\\Android-SDK

# === Community Threat Sharing (IXTIYORIY, opt-in) ===
# Foydalanuvchi ConsentActivity'da 3-galochka ("Jamoatchilik xavfsizligi") ni
# bossagina ishlaydi. Bo'sh qoldirsangiz — funksiya umuman ishlamaydi.
#
# Token olish: Telegram'da @BotFather → /newbot → tokenni nusxalang
# Chat ID olish: yangi guruh yarating, botni qo'shing, /start yozing,
#                keyin: api.telegram.org/bot<TOKEN>/getUpdates
#
# Token APK'ga kompilatsiya qilinadi. Agar APK leak bo'lsa — botni
# @BotFather → /revoke orqali yangilang.
dev.tg.bot.token=
dev.tg.chat.id=

# === KiberQalqon Cloud (markaziy monitoring paneli) ===
# Vercel'ga deploy qilingan loyihaning manzili + qurilma yozish kaliti.
# Foydalanuvchi community sharing (3-galochka) ni yoqsagina ma'lumot yuboriladi.
# Bo'sh qoldirsangiz — xarita/panelga hech narsa bormaydi (funksiya o'chiq).
#
# cloud.base.url      — Vercel deploy URL'i, masalan: https://kiberqalqon.vercel.app
#                       (oxiriga / qo'ymang)
# cloud.device.secret — Vercel ENV'dagi DEVICE_SHARED_SECRET bilan BIR XIL bo'lsin.
#                       DIQQAT: ADMIN_SECRET EMAS! Admin kaliti hech qachon APK'ga
#                       kompilatsiya qilinmaydi — u faqat panelni ochish uchun.
cloud.base.url=
cloud.device.secret=

# === Imzolangan remote-config (verdikt chegaralari) ===
# Vercel ENV CONFIG_SIGNING_SECRET bilan AYNAN bir xil bo'lsin. Bu kalit APK ichiga
# Shield shifrida kompilatsiya qilinadi (RemoteConfig imzoni tekshiradi). Bo'sh bo'lsa —
# ilova baked (ichki) standart chegaralarda qoladi (xavfsiz, lekin markaziy tighten yo'q).
config.signing.secret=
